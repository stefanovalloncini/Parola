    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola reads the frontmost window so the dictation cleanup AI has more context about what you're working on. You can disable this in Settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola legge la finestra in primo piano per dare alla pulizia AI della dettatura più contesto su ciò su cui stai lavorando. Puoi disattivarlo nelle Impostazioni."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola uses Apple Speech to transcribe audio locally when you pick the Apple Speech engine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola usa Apple Speech per trascrivere l'audio in locale quando scegli il motore Apple Speech."
          }
        }
      }
    },
    "NSSystemAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola captures system audio so it can transcribe what's playing on your Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola cattura l'audio di sistema per trascrivere ciò che riproduce il tuo Mac."
          }
        }
      }
    }
