    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola records audio from the microphone to transcribe it locally."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola registra audio dal microfono per trascriverlo in locale."
          }
        }
