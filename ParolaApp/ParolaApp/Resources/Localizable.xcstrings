    " Another app that uses this folder may still need it.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Un'altra app che usa questa cartella potrebbe averne ancora bisogno."
          }
