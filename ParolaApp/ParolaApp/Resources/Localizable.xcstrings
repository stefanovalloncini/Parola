    "%@ can't detect speakers, so speaker detection is skipped.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non sa distinguere gli speaker, quindi l'identificazione degli speaker viene saltata."
          }
        }
      }
    },
    "%@ can't label speakers.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non sa distinguere gli speaker."
          }
        }
      }
    },
    "%@ didn't send back the new page, so Parola stopped rather than make a second one.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha restituito la nuova pagina, quindi Parola si è fermata per non crearne una seconda."
          }
        }
      }
    },
    "%@ got %lld of %lld blocks before it failed, and the page stays there. %@": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha ricevuto %lld blocchi su %lld prima di fallire, e la pagina resta lì. %@"
          }
        }
      }
    },
    "%@ has moved to another address (HTTP %lld). Update its address in Send To settings.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è spostato a un altro indirizzo (HTTP %lld). Aggiorna l'indirizzo nelle impostazioni di Invia a."
          }
        }
      }
    },
    "%@ has no saved key. Enter it again in Send To settings.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha una chiave salvata. Inseriscila di nuovo nelle impostazioni di Invia a."
          }
        }
      }
    },
    "%@ is English-only. Pick a multilingual model (like Whisper) to transcribe other languages.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è solo in inglese. Scegli un modello multilingue (come Whisper) per trascrivere altre lingue."
          }
        }
      }
    },
    "%@ can't transcribe %@. Pick a multilingual model (like Whisper) to transcribe other languages.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non trascrive %@. Scegli un modello multilingue (come Whisper) per trascrivere altre lingue."
          }
        }
      }
    },
