    " Another app that uses this folder may still need it.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Un'altra app che usa questa cartella potrebbe averne ancora bisogno."
          }
        }
      }
    },
    "%1$@ is folded into %2$@, and the transcripts that named them take the new name. That rewrite can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ viene unita a %2$@ e le trascrizioni che la nominavano prendono il nuovo nome. La riscrittura non si può annullare."
          }
        }
      }
    },
