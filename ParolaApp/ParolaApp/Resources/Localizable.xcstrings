        }
      }
    },
    "The transcript will be replaced. Its summary, chapters, action items, favorites, notes, translation, chat and speaker assignments will be removed. If Generate an AI title and summary is on, a new AI title is written.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript will be replaced. Its summary, chapters, action items, favorites, notes, translation, chat and speaker assignments will be removed. If Generate an AI title and summary is on, a new AI title is written."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione verrà sostituita. Riassunto, capitoli, azioni, preferiti, note, traduzione, chat e assegnazioni degli speaker verranno rimossi. Se “Genera un titolo e un riassunto con l'AI” è attivo, viene scritto un nuovo titolo."
