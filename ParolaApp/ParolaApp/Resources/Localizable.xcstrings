    "Hotkey.Refused.OptionOnly": {
      "comment": "Shown next to a saved shortcut that uses only the Option key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut with only ⌥ works outside Parola only with Accessibility, and may type its character. Record it again with ⌘ or ⌃."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scorciatoia con solo ⌥ funziona fuori da Parola solo con l'Accessibilità e può scrivere il suo carattere. Registrala di nuovo con ⌘ o ⌃."
          }
        }
      }
    },
    "Hotkey.Refused.Parola": {
      "comment": "Shown next to a saved shortcut that Parola itself refuses to register.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola can't use this combination. Press ⌘ or ⌃ with a key, or an F key."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola non può usare questa combinazione. Premi ⌘ o ⌃ con un tasto, oppure un tasto F."
          }
        }
      }
    },
    "Hotkey.Refused.System": {
      "comment": "Shown next to a saved shortcut that macOS refused to register.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS won't reserve this combination. Outside Parola it works only with Accessibility; without it, only while Parola is in front."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non riserva questa combinazione. Fuori da Parola funziona solo con l'Accessibilità; senza, solo quando Parola è in primo piano."
          }
        }
      }
    },
    "Hotkey.Reject.NeedsModifier": {
      "comment": "Shown under the shortcut recorder when the pressed combination is rejected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut needs ⌘ or ⌃, or must be an F key. Press another combination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scorciatoia richiede ⌘ o ⌃, oppure deve essere un tasto F. Premi un'altra combinazione."
          }
        }
      }
    },
    "Hotkey.Reject.OptionOnly": {
      "comment": "Shown under the shortcut recorder when the pressed combination is rejected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS doesn't allow shortcuts that use only ⌥ or ⌥⇧. Add ⌘ or ⌃, or use an F key on its own."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non consente scorciatoie con solo ⌥ o ⌥⇧. Aggiungi ⌘ o ⌃, oppure usa un tasto F da solo."
          }
        }
      }
    },
    "Hotkey.Reject.Reserved": {
      "comment": "Shown under the shortcut recorder when the pressed combination is rejected (for example ⌘Q).",
