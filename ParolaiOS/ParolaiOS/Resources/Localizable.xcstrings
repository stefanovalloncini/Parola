    "onboarding.model.headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pick how Parola listens." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Scegli come ascolta Parola." } }
      }
    },
    "onboarding.model.subhead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "More accuracy means a bigger download. You can change this later." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Più precisione significa download più grande. Puoi cambiarlo dopo." } }
      }
    },
    "onboarding.model.tiny.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick notes and clear voices." } },
