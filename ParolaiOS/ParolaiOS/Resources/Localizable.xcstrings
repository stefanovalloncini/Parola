    "onboarding.welcome.body.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drop in any audio. Record meetings or notes." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Trascina un audio. Registra riunioni o appunti." } }
      }
    },
    "onboarding.welcome.body.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read along, word by word." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Leggi parola per parola." } }
      }
    },
    "onboarding.welcome.body.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything stays on this iPhone." } },
