---
import { links } from "../data/links";
import { translator } from "../i18n";
import WaveGlyph from "./WaveGlyph.astro";

interface Props {
  stacked?: boolean;
}

const { stacked = false } = Astro.props;
const t = translator(Astro.currentLocale);
---

<div class:list={["buttons", { stacked }]}>
  <a class="primary" href={links.download}>
    {t({ en: "Download for Mac", it: "Scarica per Mac" })}
    <WaveGlyph />
  </a>
  <a class="secondary" href={links.repository}>
    {t({ en: "View on GitHub", it: "Vedi su GitHub" })}
  </a>
</div>

<style>
  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .stacked {
    display: grid;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 50px;
    padding-inline: 24px;
    border-radius: var(--radius-control);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .primary {
    background: radial-gradient(60% 120% at 50% 0%, #5f7f60, var(--sage-deep));
    color: #fff;
    box-shadow:
      0 0 0 1px #33503b,
      0 1px 1px rgb(15 26 20 / 0.08),
      0 10px 22px -10px rgb(63 96 72 / 0.8);
  }

  .primary :global(.wave-glyph) {
    color: #d7e6d3;
  }

  .secondary {
    background: var(--paper);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(15 26 20 / 0.14);
  }

  .primary:hover,
  .secondary:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 520px) {
    .buttons {
      display: grid;
      width: min(100%, 340px);
    }
  }
</style>
