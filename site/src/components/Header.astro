---
import { links } from "../data/links";
import BrandIcon from "./BrandIcon.astro";
import WaveGlyph from "./WaveGlyph.astro";

const onHome = Astro.url.pathname === "/";
const anchor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Parola home">
      <BrandIcon size={32} />
      <span>Parola</span>
    </a>
    <nav class="nav" aria-label="Sections">
      <a href={anchor("features")}>Features</a>
      <a href={anchor("privacy")}>Privacy</a>
      <a href={anchor("faq")}>FAQ</a>
    </nav>
    <div class="actions">
      <a class="github" href={links.repository}>
        GitHub
      </a>
      <a class="download" href={links.download}>
        <span>Download</span>
        <WaveGlyph />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 4);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    transition:
      background-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .site-header[data-scrolled] {
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 0.5px 0 var(--hairline);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  .header-inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a,
  .github {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-body);
    transition: color 0.2s;
  }

  .nav a:hover,
  .github:hover {
    color: var(--ink);
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 18px 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 15px;
    font-weight: 550;
    letter-spacing: -0.01em;
    box-shadow:
      0 0 0 1px rgb(107 138 107 / 0.45),
      0 10px 24px -10px rgb(15 26 20 / 0.7);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .download :global(.wave-glyph) {
    color: var(--sage-soft);
  }

  .download:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgb(169 194 166 / 0.7),
      0 14px 28px -10px rgb(15 26 20 / 0.75);
  }

  @media (max-width: 860px) {
    .nav,
    .github {
      display: none;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 720px) {
    .download {
      height: 38px;
      padding: 0 14px 0 16px;
      font-size: 14px;
    }
  }
</style>
