---
import { links } from "../data/links";
import { localeOf, pathFor, switchPath, translator } from "../i18n";
import BrandIcon from "./BrandIcon.astro";
import WaveGlyph from "./WaveGlyph.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const home = pathFor(locale, "/");
const onHome = Astro.url.pathname === home;
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const other = locale === "it" ? "en" : "it";
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={home} aria-label={t({ en: "Parola home", it: "Home di Parola" })}>
      <BrandIcon size={32} />
      <span>Parola</span>
    </a>
    <nav class="nav" aria-label={t({ en: "Sections", it: "Sezioni" })}>
      <a href={anchor("features")}>{t({ en: "Features", it: "Funzioni" })}</a>
      <a href={anchor("privacy")}>Privacy</a>
      <a href={anchor("faq")}>{t({ en: "FAQ", it: "Domande" })}</a>
    </nav>
    <div class="actions">
      <a class="lang" href={switchPath(other, Astro.url.pathname)} hreflang={other} lang={other}>
        <span class="long">{other === "it" ? "Italiano" : "English"}</span>
        <span class="short">{other === "it" ? "IT" : "EN"}</span>
      </a>
      <a class="github" href={links.repository}>
        GitHub
      </a>
      <a class="download" href={anchor("download")}>
        <span>{t({ en: "Download", it: "Scarica" })}</span>
        <WaveGlyph />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 4);
    requestAnimationFrame(onScroll);
    window.addEventListener("scroll", onScroll, { passive: true });

    const bands = document.querySelectorAll<HTMLElement>('[data-theme="dark"]');
    const underHeader = new Set<Element>();
    let observer: IntersectionObserver | undefined;
    const watch = () => {
      observer?.disconnect();
      underHeader.clear();
      const line = Math.round(header.offsetHeight / 2);
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) underHeader.add(entry.target);
            else underHeader.delete(entry.target);
          }
          header.toggleAttribute("data-over-dark", underHeader.size > 0);
        },
        { rootMargin: `-${line}px 0px -${Math.max(window.innerHeight - line - 1, 0)}px 0px` },
      );
      bands.forEach((band) => observer?.observe(band));
    };
    requestAnimationFrame(watch);
    window.addEventListener("resize", watch);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    transition:
      background-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  :global(html:not(.js)) .site-header,
  .site-header[data-scrolled] {
    background: rgb(255 255 255 / 0.88);
    box-shadow: 0 0.5px 0 var(--hairline);
    backdrop-filter: saturate(180%) blur(20px);
  }

  .header-inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .site-header[data-over-dark] {
    --ink: var(--cream);
    --ink-body: rgb(252 242 230 / 0.82);
    background: rgb(8 17 12 / 0.72);
    box-shadow: 0 0.5px 0 rgb(252 242 230 / 0.1);
  }

  .site-header[data-over-dark] .download {
    background: var(--cream);
    color: #0f1a14;
  }

  .site-header[data-over-dark] .download :global(.wave-glyph) {
    color: var(--sage);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a,
  .github,
  .lang {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-body);
    transition: color 0.2s;
  }

  .nav a:hover,
  .github:hover,
  .lang:hover {
    color: var(--ink);
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 18px 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 15px;
    font-weight: 550;
    letter-spacing: -0.01em;
    box-shadow:
      0 0 0 1px rgb(107 138 107 / 0.45),
      0 10px 24px -10px rgb(15 26 20 / 0.7);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      opacity 0.2s var(--ease-out);
  }

  :global(html:has([data-stick-card].is-stuck)) .download {
    opacity: 0;
    pointer-events: none;
  }

  .download :global(.wave-glyph) {
    color: var(--sage-soft);
  }

  .download:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgb(169 194 166 / 0.7),
      0 14px 28px -10px rgb(15 26 20 / 0.75);
  }

  .short {
    display: none;
  }

  @media (max-width: 860px) {
    .nav,
    .github,
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 720px) {
    .download {
      height: 44px;
      padding: 0 16px 0 18px;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not(.js)) .site-header,
    .site-header[data-scrolled] {
      background: rgb(8 17 12 / 0.72);
    }

    .download :global(.wave-glyph) {
      color: var(--sage);
    }
  }
</style>
