---
import type { GlyphName, Hue } from "../../data/icons";
import { translator } from "../../i18n";
import IconTile from "../IconTile.astro";
import Lines from "../Lines.astro";
import OfflineScene from "../cards/OfflineScene.astro";

const t = translator(Astro.currentLocale);

const points: { glyph: GlyphName; hue: Hue; title: string; text: string }[] = t({
  en: [
    {
      glyph: "folder-lock",
      hue: "sage",
      title: "Nothing uploaded",
      text: "Your recordings and transcripts stay in your library on this Mac.",
    },
    {
      glyph: "wifi-slash",
      hue: "slate",
      title: "Works offline",
      text: "Once a model is downloaded, transcription needs no connection.",
    },
    {
      glyph: "eye-slash",
      hue: "clay",
      title: "No account",
      text: "Parola has no sign-in and sends no analytics. An AI service you add gets the text, never the audio.",
    },
  ],
  it: [
    {
      glyph: "folder-lock",
      hue: "sage",
      title: "Nessun caricamento",
      text: "Registrazioni e trascrizioni restano nella libreria, su questo Mac.",
    },
    {
      glyph: "wifi-slash",
      hue: "slate",
      title: "Funziona offline",
      text: "Una volta scaricato un modello, la trascrizione non ha bisogno della rete.",
    },
    {
      glyph: "eye-slash",
      hue: "clay",
      title: "Nessun account",
      text: "Parola non chiede di accedere e non invia statistiche. Un servizio AI che aggiungi riceve il testo, mai l’audio.",
    },
  ],
});
---

<section class="privacy section" id="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="section-head">
      <IconTile glyph="lock" hue="sage" size="64px" class="lock" />
      <h2 id="privacy-title" class="t-section" data-words>
        <Lines
          lines={t({
            en: ["Your words stay", "on your Mac."],
            it: ["Le tue parole restano", "sul tuo Mac."],
          })}
        />
      </h2>
      <p class="t-lead">
        {t({
          en: "Transcription runs on your Mac’s own chips, with the Wi‑Fi on or off.",
          it: "La trascrizione gira sui chip del tuo Mac, con il Wi‑Fi acceso o spento.",
        })}
      </p>
    </div>
    <div class="stage">
      <OfflineScene />
    </div>
    <ul class="points">
      {points.map((point) => (
        <li>
          <h3>
            <IconTile glyph={point.glyph} hue={point.hue} size="34px" />
            {point.title}
          </h3>
          <p>{point.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head :global(.lock) {
    margin-bottom: 22px;
  }

  .stage {
    --u: calc(100cqw / 936);
    position: relative;
    aspect-ratio: 936 / 380;
    overflow: hidden;
    border-radius: var(--radius-card);
    container-type: inline-size;
    isolation: isolate;
  }

  .stage > :global(*) {
    --u: calc(100cqw / 936);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 40px;
    margin-top: 40px;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  p {
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .stage {
      aspect-ratio: 504 / 440;
    }

    .stage > :global(*) {
      --u: calc(100cqw / 500);
    }

    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
