---
import { localeOf, translator } from "../../i18n";
import FeatureCard from "../cards/FeatureCard.astro";
import PromptsScene from "../cards/PromptsScene.astro";
import ProvidersScene from "../cards/ProvidersScene.astro";
import Lines from "../Lines.astro";
import ShotTabs, { type ShotTab } from "../ShotTabs.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);

const tabs: ShotTab[] = [
  {
    id: "summary",
    label: t({ en: "Summary", it: "Riassunto" }),
    shot: "ai-summary",
    alt: t({
      en: "A meeting summary in Parola with key points and action items.",
      it: "Il riassunto di una riunione in Parola, con i punti chiave e le cose da fare.",
    }),
  },
  {
    id: "chat",
    label: "Chat",
    shot: "ai-chat",
    alt: t({
      en: "A chat about a transcript in Parola, answering with the timestamp it quotes.",
      it: "Una chat su una trascrizione in Parola, con una risposta che cita il minutaggio.",
    }),
  },
];

const copy = t({
  en: {
    title: ["Summaries and answers,", "from the model you choose."],
    lead: "Apple Intelligence answers on your Mac. Add your own key for OpenAI or Anthropic, or run a model with Ollama.",
    tabs: "AI views",
    prompts: {
      title: "Nineteen prompts",
      text: "Action items, key points, an FAQ or a mind map, one click away. You can also write your own in plain words.",
    },
    local: {
      title: "Local or cloud",
      text: "Pick a service for each job: summary, chat, prompts or dictation cleanup. Keys stay in your keychain.",
    },
    privacy: "A cloud service gets text, never your audio, and Parola asks before the first time.",
  },
  it: {
    title: ["Riassunti e risposte,", "dal modello che scegli tu."],
    lead: "Apple Intelligence risponde sul tuo Mac. Aggiungi la tua chiave per OpenAI o Anthropic, oppure usa un modello con Ollama.",
    tabs: "Viste AI",
    prompts: {
      title: "Diciannove prompt",
      text: "Cose da fare, punti chiave, FAQ o una mappa mentale, a un clic. Puoi anche scriverne di tuoi, con parole semplici.",
    },
    local: {
      title: "Locale o cloud",
      text: "Scegli un servizio per ogni compito: riassunto, chat, prompt o pulizia della dettatura. Le chiavi restano nel portachiavi.",
    },
    privacy:
      "Un servizio cloud riceve il testo, mai il tuo audio, e Parola chiede conferma la prima volta.",
  },
});
---

<section class="ai section" aria-labelledby="ai-title">
  <div class="container">
    <div class="section-head">
      <h2 id="ai-title" class="t-section" data-words>
        <Lines lines={copy.title} loose />
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>
    <ShotTabs name="ai" tabs={tabs} label={copy.tabs} />

    <div class="grid">
      <FeatureCard title={copy.prompts.title} text={copy.prompts.text}>
        <PromptsScene />
      </FeatureCard>
      <FeatureCard title={copy.local.title} text={copy.local.text} note={copy.privacy}>
        <ProvidersScene />
      </FeatureCard>
    </div>
  </div>
</section>

<style>
  .ai {
    background:
      radial-gradient(60% 40% at 18% 8%, rgb(107 138 107 / 0.16), transparent 70%),
      radial-gradient(50% 36% at 85% 4%, rgb(84 115 158 / 0.13), transparent 70%),
      linear-gradient(180deg, #f6f8f5 0%, var(--paper) 42%);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 32px;
    margin-top: clamp(96px, 11vw, 160px);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .ai {
      background:
        radial-gradient(60% 40% at 18% 8%, rgb(107 138 107 / 0.16), transparent 70%),
        radial-gradient(50% 36% at 85% 4%, rgb(84 115 158 / 0.13), transparent 70%),
        linear-gradient(180deg, #0f1a14 0%, var(--paper) 42%);
    }
  }
</style>
