---
import { shotsFor } from "../../data/shots";
import { localeOf, translator } from "../../i18n";
import FeatureCard from "../cards/FeatureCard.astro";
import PromptsScene from "../cards/PromptsScene.astro";
import ProvidersScene from "../cards/ProvidersScene.astro";
import Icon from "../Icon.astro";
import Lines from "../Lines.astro";
import ShotTabs from "../ShotTabs.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const shots = shotsFor(locale);

const tabs = [
  {
    id: "summary",
    label: t({ en: "Summary", it: "Riassunto" }),
    image: shots["ai-summary"],
    alt: t({
      en: "A meeting summary in Parola with key points and action items.",
      it: "Il riassunto di una riunione in Parola, con i punti chiave e le cose da fare.",
    }),
  },
  {
    id: "chat",
    label: "Chat",
    image: shots["ai-chat"],
    alt: t({
      en: "A chat about a transcript in Parola, answering with the timestamp it quotes.",
      it: "Una chat su una trascrizione in Parola, con il minutaggio della risposta.",
    }),
  },
  {
    id: "services",
    label: t({ en: "Services", it: "Servizi" }),
    image: shots["ai-prompts"],
    alt: t({
      en: "Parola's AI Services settings: Apple Intelligence on the Mac, plus Ollama and OpenAI, picked per task.",
      it: "Le impostazioni dei servizi AI di Parola: Apple Intelligence sul Mac, più Ollama e OpenAI, scelti per compito.",
    }),
  },
];

const here = t({ en: "On this Mac", it: "Su questo Mac" });
const key = t({ en: "Your key", it: "La tua chiave" });
const services = [
  { name: "Apple Intelligence", where: here, local: true },
  { name: "Ollama", where: here, local: true },
  { name: "OpenAI", where: key, local: false },
  { name: "Anthropic", where: key, local: false },
  { name: "Groq", where: key, local: false },
  { name: "Cerebras", where: key, local: false },
  {
    name: t({ en: "Your own endpoint", it: "Il tuo endpoint" }),
    where: t({ en: "OpenAI-compatible", it: "Compatibile con OpenAI" }),
    local: false,
  },
];

const copy = t({
  en: {
    title: ["Summaries and answers,", "from the model you choose."],
    lead: "Apple Intelligence answers on your Mac. Add your own key for OpenAI or Anthropic, or run a model with Ollama.",
    tabs: "AI views",
    prompts: {
      title: "Nineteen prompts",
      text: "Action items, key points, an FAQ or a mind map, one click away. You can also write your own in plain words.",
    },
    local: {
      title: "Local or cloud",
      text: "Pick a service for each job: summary, chat, prompts or dictation cleanup. Keys stay in your keychain.",
    },
    services: "Use the model you already have",
    servicesLead:
      "A cloud service gets text, never your audio, and Parola asks before the first time.",
  },
  it: {
    title: ["Riassunti e risposte,", "dal modello che scegli tu."],
    lead: "Apple Intelligence risponde sul tuo Mac. Aggiungi la tua chiave per OpenAI o Anthropic, oppure usa un modello con Ollama.",
    tabs: "Viste AI",
    prompts: {
      title: "Diciannove prompt",
      text: "Azioni, punti chiave, FAQ o una mappa mentale, a un clic. Puoi anche scriverne di tuoi, con parole semplici.",
    },
    local: {
      title: "Locale o cloud",
      text: "Scegli un servizio per ogni compito: riassunto, chat, prompt o pulizia della dettatura. Le chiavi restano nel portachiavi.",
    },
    services: "Usa il modello che hai già",
    servicesLead:
      "Un servizio cloud riceve il testo, mai il tuo audio, e Parola chiede conferma la prima volta.",
  },
});
---

<section class="ai section" aria-labelledby="ai-title">
  <div class="container">
    <div class="section-head">
      <h2 id="ai-title" class="t-section" data-words>
        <Lines lines={copy.title} />
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>
    <ShotTabs name="ai" tabs={tabs} label={copy.tabs} />

    <div class="grid">
      <FeatureCard title={copy.prompts.title} text={copy.prompts.text}>
        <PromptsScene />
      </FeatureCard>
      <FeatureCard title={copy.local.title} text={copy.local.text}>
        <ProvidersScene />
      </FeatureCard>
    </div>

    <div class="services">
      <h3 class="t-card">{copy.services}</h3>
      <p class="t-lead">{copy.servicesLead}</p>
      <ul>
        {services.map((service) => (
          <li>
            <span class:list={["tile", { local: service.local }]}>
              <Icon name={service.local ? "chip" : "globe"} size={22} />
            </span>
            <span>
              <b>{service.name}</b>
              <small>{service.where}</small>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ai {
    background:
      radial-gradient(60% 40% at 18% 8%, rgb(107 138 107 / 0.16), transparent 70%),
      radial-gradient(50% 36% at 85% 4%, rgb(84 115 158 / 0.13), transparent 70%),
      linear-gradient(180deg, #f6f8f5 0%, var(--paper) 42%);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 32px;
    margin-top: clamp(96px, 11vw, 160px);
  }

  .services {
    margin-top: clamp(96px, 11vw, 150px);
  }

  .services .t-lead {
    margin-top: 12px;
  }

  .services ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 40px;
    border-top: 0.5px solid var(--hairline);
  }

  .services li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 24px 12px 24px 0;
    border-bottom: 0.5px solid var(--hairline);
  }

  .services li span:last-child {
    display: grid;
  }

  .services b {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .services small {
    font-size: 14px;
    color: var(--muted);
  }

  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #e8edf5;
    color: var(--slate);
  }

  .tile.local {
    background: var(--sage-tint);
    color: var(--sage-deep);
  }

  @media (max-width: 900px) {
    .services ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .services ul {
      grid-template-columns: 1fr;
    }
  }
</style>
