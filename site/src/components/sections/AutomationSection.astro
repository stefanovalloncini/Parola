---
import { hues, type GlyphName, type Hue } from "../../data/icons";
import { links } from "../../data/links";
import { translator } from "../../i18n";
import FeatureCard from "../cards/FeatureCard.astro";
import McpScene from "../cards/McpScene.astro";
import TerminalScene from "../cards/TerminalScene.astro";
import IconTile from "../IconTile.astro";
import Lines from "../Lines.astro";

const t = translator(Astro.currentLocale);
const actions: { glyph: GlyphName; hue: Hue }[] = [
  { glyph: "file-audio", hue: "slate" },
  { glyph: "record", hue: "clay" },
  { glyph: "stop", hue: "clay" },
  { glyph: "microphone", hue: "sage" },
  { glyph: "microphone-slash", hue: "sage" },
  { glyph: "sparkle", hue: "plum" },
  { glyph: "file-text", hue: "plum" },
];

const copy = t({
  en: {
    title: ["Works with Shortcuts,", "the terminal and Claude."],
    cli: {
      title: "The parola command",
      text: "Transcribe and record from the terminal, with the same engines the app uses.",
    },
    mcp: {
      title: "Claude and other LLMs",
      text: "Parola speaks MCP. Add it to Claude Code, then ask for what you want in plain words.",
    },
    shortcuts: "Shortcuts actions",
    intents: [
      "Transcribe File",
      "Start Recording",
      "Stop Recording",
      "Start Dictation",
      "Stop Dictation",
      "Summarize Last Transcript",
      "Open Last Transcript",
    ],
    setup: "Setup for Claude Desktop and other clients is in the",
    guide: "MCP guide",
  },
  it: {
    title: ["Funziona con Comandi Rapidi,", "il Terminale e Claude."],
    cli: {
      title: "Il comando parola",
      text: "Trascrivi e registra dal Terminale, con gli stessi motori dell’app.",
    },
    mcp: {
      title: "Claude e altri LLM",
      text: "Parola parla MCP. Aggiungilo a Claude Code e chiedi quello che ti serve con parole tue.",
    },
    shortcuts: "Azioni per Comandi Rapidi",
    intents: [
      "Trascrivi file",
      "Avvia registrazione",
      "Ferma registrazione",
      "Avvia dettatura",
      "Ferma dettatura",
      "Riassumi ultima trascrizione",
      "Apri ultima trascrizione",
    ],
    setup: "La configurazione per Claude Desktop e gli altri client è nella",
    guide: "guida MCP (in inglese)",
  },
});
---

<section class="automation section" aria-labelledby="automation-title">
  <div class="container">
    <div class="section-head">
      <h2 id="automation-title" class="t-section minor" data-words>
        <Lines lines={copy.title} loose />
      </h2>
    </div>
    <div class="grid">
      <FeatureCard title={copy.cli.title} text={copy.cli.text}>
        <TerminalScene />
      </FeatureCard>
      <FeatureCard title={copy.mcp.title} text={copy.mcp.text}>
        <McpScene />
      </FeatureCard>
    </div>
    <div class="shortcuts">
      <h3 class="t-row">{copy.shortcuts}</h3>
      <ul>
        {actions.map((action, i) => (
          <li style={`--hue: ${hues[action.hue].accent}`}>
            <IconTile glyph={action.glyph} hue={action.hue} size="22px" />
            {copy.intents[i]}
          </li>
        ))}
      </ul>
      <p class="t-lead">
        {copy.setup} <a href={links.mcpDocs}>{copy.guide}</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 32px;
  }

  .shortcuts {
    margin-top: clamp(64px, 8vw, 104px);
    padding-top: 30px;
    border-top: 0.5px solid var(--hairline);
  }

  .shortcuts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 28px;
  }

  .shortcuts li {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px 10px 10px;
    border-radius: 999px;
    white-space: nowrap;
    background: color-mix(in srgb, var(--hue) 14%, #fff);
    color: color-mix(in srgb, var(--hue) 70%, #000);
    font-size: 15px;
    font-weight: 600;
  }

  .shortcuts a {
    color: var(--sage-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
