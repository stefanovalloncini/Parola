---
import { credits as creditCopy, openWork } from "../../data/credits";
import { links } from "../../data/links";
import { translator } from "../../i18n";

const t = translator(Astro.currentLocale);
const credits = t(creditCopy);
const copy = t(openWork);
---

<section class="open section" aria-labelledby="open-title">
  <div class="container">
    <div class="section-head">
      <h2 id="open-title" class="t-section minor" data-words>
        {copy.title}
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>
    <ul class="wall">
      {credits.map((credit) => (
        <li>
          <h3 class="name">
            {credit.href ? <a href={credit.href}>{credit.name}</a> : credit.name}
          </h3>
          {credit.maker && <p class="maker">{credit.maker}</p>}
          <p class="quote">{`${credit.before} ${credit.mark}${credit.after}`}</p>
        </li>
      ))}
      <li class="source">
        <p class="quote">
          {copy.sourceBefore} <span class="hl">{copy.sourceMark}</span>
          {copy.sourceAfter}
        </p>
        <a class="button" href={links.repository}>
          {copy.button}
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 24px 28px;
    border-radius: var(--radius-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .name a {
    display: inline-block;
    padding-block: 8px;
    margin-block: -8px;
    color: inherit;
    transition: color 0.2s;
  }

  .name a:hover {
    color: var(--sage-deep);
  }

  .maker {
    margin-top: -6px;
    font-size: 13px;
    color: var(--muted);
  }

  .quote {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }

  .source {
    align-content: space-between;
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(107 138 107 / 0.35), transparent 70%), var(--night);
    box-shadow: none;
  }

  .source .quote {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--cream);
  }

  .hl {
    padding: 0 0.12em;
    margin-inline: -0.04em;
    border-radius: 0.2em;
    color: #cfe0cb;
    background: rgb(169 194 166 / 0.18);
    white-space: nowrap;
  }

  .button {
    justify-self: start;
    white-space: nowrap;
    padding: 12px 20px;
    border-radius: var(--radius-control);
    background: var(--cream);
    color: #0f1a14;
    font-weight: 600;
    transition: transform 0.2s var(--ease-out);
  }

  .button:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 1100px) {
    .wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .wall {
      grid-template-columns: 1fr;
      gap: 0;
    }

    li:not(.source) {
      padding: 16px 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      border-top: 0.5px solid var(--hairline);
    }

    .source {
      margin-top: 16px;
    }
  }
</style>
