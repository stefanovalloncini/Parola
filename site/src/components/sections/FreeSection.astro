---
import { included } from "../../data/included";
import { links, requirements } from "../../data/links";
import BrandIcon from "../BrandIcon.astro";
import Icon from "../Icon.astro";
import WaveGlyph from "../WaveGlyph.astro";
---

<section class="free section" id="download" aria-labelledby="free-title">
  <div class="narrow">
    <div class="section-head">
      <h2 id="free-title" class="t-section" data-words>
        Free and open source.
      </h2>
      <p class="t-lead">Every feature is in the download. There's no paid tier and no account.</p>
    </div>

    <div class="card">
      <div class="who">
        <BrandIcon size={64} />
        <div>
          <p class="name">Parola</p>
          <p class="price">Free</p>
          <p class="note">MIT license. {requirements}.</p>
        </div>
      </div>
      <div class="actions">
        <a class="primary" href={links.download}>
          Download for Mac
          <WaveGlyph />
        </a>
        <a class="secondary" href={links.repository}>
          View on GitHub
        </a>
      </div>
    </div>

    <div class="groups">
      {included.map((group) => (
        <div class="group">
          <h3>
            <Icon name={group.icon} size={22} />
            {group.title}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="tick">
                  <Icon name="check" size={13} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .card {
    position: sticky;
    top: calc(var(--header-height) + 12px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 30px 32px;
    border-radius: var(--radius-card);
    background: rgb(243 245 242 / 0.92);
    box-shadow: inset 0 0 0 1px var(--hairline);
    backdrop-filter: blur(18px) saturate(160%);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .price {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .note {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .actions {
    display: grid;
    gap: 10px;
    min-width: min(100%, 250px);
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 50px;
    padding-inline: 24px;
    border-radius: var(--radius-control);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .primary {
    background: radial-gradient(60% 120% at 50% 0%, #7f9e7e, var(--sage-deep));
    color: #fff;
    box-shadow:
      0 0 0 1px #33503b,
      0 1px 1px rgb(15 26 20 / 0.08),
      0 10px 22px -10px rgb(63 96 72 / 0.8);
  }

  .primary :global(.wave-glyph) {
    color: #d7e6d3;
  }

  .secondary {
    background: var(--paper);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(15 26 20 / 0.14);
  }

  .primary:hover,
  .secondary:hover {
    transform: translateY(-1px);
  }

  .groups {
    margin-top: 28px;
  }

  .group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 16px 24px;
    padding: 30px 8px;
    border-bottom: 0.5px solid var(--hairline);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    align-self: start;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  ul {
    display: grid;
    gap: 14px;
  }

  li {
    display: flex;
    gap: 12px;
    font-size: 17px;
    color: var(--ink-body);
  }

  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--sage-deep);
    color: #fff;
  }

  .tick :global(svg) {
    stroke-width: 2.6;
  }

  @media (max-width: 720px) {
    .card {
      position: static;
      padding: 26px 22px;
    }

    .actions {
      width: 100%;
    }

    .group {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
  }
</style>
