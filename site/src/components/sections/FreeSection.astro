---
import { included as groups } from "../../data/included";
import { requirements } from "../../data/links";
import { translator } from "../../i18n";
import BrandIcon from "../BrandIcon.astro";
import DownloadButtons from "../DownloadButtons.astro";
import Icon from "../Icon.astro";

const t = translator(Astro.currentLocale);
const included = t(groups);
const copy = t({
  en: {
    title: "Free and open source.",
    lead: "Every feature is in the download. There's no paid tier and no account.",
    price: "Free",
    license: `MIT license. ${requirements.en}.`,
  },
  it: {
    title: "Gratis e open source.",
    lead: "Ogni funzione è inclusa nel download. Non c'è una versione a pagamento né un account.",
    price: "Gratis",
    license: `Licenza MIT. ${requirements.it}.`,
  },
});
---

<section class="free section" id="download" aria-labelledby="free-title">
  <div class="narrow">
    <div class="section-head">
      <h2 id="free-title" class="t-section minor" data-words>
        {copy.title}
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>

    <div class="card">
      <div class="who">
        <BrandIcon size={64} />
        <div>
          <p class="name">Parola</p>
          <p class="price">{copy.price}</p>
          <p class="note">{copy.license}</p>
        </div>
      </div>
      <div class="actions">
        <DownloadButtons stacked />
      </div>
    </div>

    <div class="groups">
      {included.map((group) => (
        <div class="group">
          <h3>
            <Icon name={group.icon} size={22} />
            {group.title}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="tick">
                  <Icon name="check" size={13} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .card {
    position: sticky;
    top: calc(var(--header-height) + 12px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 30px 32px;
    border-radius: var(--radius-card);
    background: rgb(243 245 242 / 0.92);
    box-shadow: inset 0 0 0 1px var(--hairline);
    backdrop-filter: blur(18px) saturate(160%);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .price {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .note {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .actions {
    min-width: min(100%, 250px);
  }

  .groups {
    margin-top: 28px;
  }

  .group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 16px 24px;
    padding: 30px 8px;
    border-bottom: 0.5px solid var(--hairline);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    align-self: start;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  ul {
    display: grid;
    gap: 14px;
  }

  li {
    display: flex;
    gap: 12px;
    font-size: 17px;
    color: var(--ink-body);
  }

  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--sage-deep);
    color: #fff;
  }

  .tick :global(svg) {
    stroke-width: 2.6;
  }

  @media (max-width: 720px) {
    .card {
      position: static;
      padding: 26px 22px;
    }

    .actions {
      width: 100%;
    }

    .group {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
  }
</style>
