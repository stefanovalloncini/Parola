---
import { included as groups } from "../../data/included";
import { requirements } from "../../data/links";
import { translator } from "../../i18n";
import BrandIcon from "../BrandIcon.astro";
import DownloadButtons from "../DownloadButtons.astro";
import Icon from "../Icon.astro";

const t = translator(Astro.currentLocale);
const included = t(groups);
const copy = t({
  en: {
    title: "Free and open source.",
    lead: "Every feature is in the download. There’s no paid tier and no account.",
    price: "Free",
    license: `MIT license. ${requirements.en}.`,
  },
  it: {
    title: "Gratis e open source.",
    lead: "Ogni funzione è inclusa nel download. Non c’è una versione a pagamento né un account.",
    price: "Gratis",
    license: `Licenza MIT. ${requirements.it}.`,
  },
});
---

<section class="free section" id="download" aria-labelledby="free-title">
  <div class="container">
    <div class="section-head">
      <h2 id="free-title" class="t-section minor" data-words>
        {copy.title}
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>

    <div class="mark-line" data-stick-mark aria-hidden="true"></div>
    <div class="dock" data-stick-card>
      <div class="card">
        <div class="who">
          <BrandIcon size={64} />
          <div>
            <p class="name">Parola</p>
            <p class="price">{copy.price}</p>
            <p class="note">{copy.license}</p>
          </div>
        </div>
        <div class="actions">
          <DownloadButtons stacked />
        </div>
      </div>
    </div>

    <div class="groups">
      {included.map((group) => (
        <div class="group">
          <h3>
            <Icon name={group.icon} size={22} />
            {group.title}
          </h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="tick">
                  <Icon name="check" size={13} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const dock = document.querySelector<HTMLElement>("[data-stick-card]");
  const mark = document.querySelector<HTMLElement>("[data-stick-mark]");
  const section = document.querySelector<HTMLElement>("#download");
  if (dock && mark && section) {
    const line = parseFloat(getComputedStyle(dock).top) || 84;
    let above = false;
    let inSection = false;
    const apply = () => {
      const stuck = above && inSection && getComputedStyle(dock).position === "sticky";
      if (stuck === dock.classList.contains("is-stuck")) return;
      const before = dock.getBoundingClientRect().height;
      dock.classList.toggle("is-stuck", stuck);
      dock.style.marginBottom = stuck ? `${before - dock.getBoundingClientRect().height}px` : "";
    };
    const options = { rootMargin: `-${line}px 0px 0px 0px` };
    new IntersectionObserver(([entry]) => {
      above = entry ? !entry.isIntersecting && entry.boundingClientRect.top < line : false;
      apply();
    }, options).observe(mark);
    new IntersectionObserver(([entry]) => {
      inSection = entry?.isIntersecting ?? false;
      apply();
    }, options).observe(section);
  }
</script>

<style>
  .dock {
    position: sticky;
    top: calc(var(--header-height) + 12px);
    z-index: 5;
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
  }

  .dock.is-stuck {
    background: var(--paper);
    box-shadow: 0 -12px 0 0 var(--paper);
  }

  .dock.is-stuck::after {
    content: "";
    position: absolute;
    inset: 100% 0 auto;
    height: 24px;
    background: linear-gradient(var(--paper), rgb(255 255 255 / 0));
    pointer-events: none;
  }

  .card {
    max-width: var(--narrow);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 30px 32px;
    border-radius: var(--radius-card);
    background: var(--mist);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .mark-line {
    height: 1px;
    margin-bottom: -1px;
  }

  .is-stuck .card {
    padding-block: 14px;
  }

  .is-stuck .who :global(svg) {
    width: 44px;
    height: 44px;
  }

  .is-stuck .name {
    font-size: 17px;
  }

  .is-stuck .price {
    font-size: 34px;
  }

  .is-stuck .note {
    display: none;
  }

  .is-stuck :global(.buttons) {
    grid-auto-flow: column;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .price {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .note {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  .actions {
    min-width: min(100%, 250px);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px 32px;
    padding-top: 64px;
  }

  .group {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  ul {
    display: grid;
    gap: 10px;
  }

  li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: var(--ink-body);
  }

  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--sage-deep);
    color: #fff;
  }

  .tick :global(svg) {
    stroke-width: 2.6;
  }

  @media (max-width: 1000px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .dock {
      position: static;
    }

    .card {
      padding: 26px 22px;
    }

    .actions {
      width: 100%;
    }
  }
</style>
