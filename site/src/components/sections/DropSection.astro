---
import { shotsFor } from "../../data/shots";
import { localeOf, translator } from "../../i18n";
import DocTile from "../DocTile.astro";
import Lines from "../Lines.astro";
import ShotTabs from "../ShotTabs.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const shots = shotsFor(locale);

const fan = [
  { ext: "MP3", tint: "#3f6048", r: -16, x: -150, y: 26 },
  { ext: "MP4", tint: "#54739e", r: -8, x: -76, y: 6 },
  { ext: "M4A", tint: "#6b8a6b", r: 0, x: 0, y: 0 },
  { ext: "MOV", tint: "#7b6f95", r: 8, x: 76, y: 6 },
  { ext: "WAV", tint: "#a07b5a", r: 16, x: 150, y: 26 },
];

const tabs = [
  {
    id: "interviews",
    label: t({ en: "Interviews", it: "Interviste" }),
    image: shots.interview,
    alt: t({
      en: "An interview in Parola. Each line carries the speaker's name and a timestamp.",
      it: "Un'intervista in Parola. Ogni riga riporta il nome di chi parla e il minutaggio.",
    }),
  },
  {
    id: "memos",
    label: t({ en: "Voice memos", it: "Memo vocali" }),
    image: shots.memo,
    alt: t({
      en: "A short voice memo in Parola, summarized with its action items.",
      it: "Un breve memo vocale in Parola, riassunto insieme alle cose da fare.",
    }),
  },
  {
    id: "lectures",
    label: t({ en: "Lectures", it: "Lezioni" }),
    image: shots.lecture,
    alt: t({
      en: "A lecture transcript in Parola with chapters you can jump to.",
      it: "La trascrizione di una lezione in Parola, con i capitoli a cui saltare.",
    }),
  },
  {
    id: "subtitles",
    label: t({ en: "Subtitles", it: "Sottotitoli" }),
    image: shots.export,
    alt: t({
      en: "Parola's export sheet previewing SubRip subtitles before saving.",
      it: "La finestra di esportazione di Parola con l'anteprima dei sottotitoli SubRip.",
    }),
  },
];
---

<section class="drop section" id="features" aria-labelledby="drop-title">
  <div class="container">
    <div class="fan" data-loop aria-hidden="true">
      {fan.map((tile, i) => (
        <span
          class="fan-tile"
          style={`--r: ${tile.r}deg; --x: ${tile.x}px; --y: ${tile.y}px; --i: ${i}`}
        >
          <DocTile ext={tile.ext} tint={tile.tint} />
        </span>
      ))}
    </div>
    <div class="section-head">
      <h2 id="drop-title" class="t-section" data-words>
        <Lines
          lines={t({
            en: ["Drop a file.", "Read every word."],
            it: ["Trascina un file.", "Leggi ogni parola."],
          })}
        />
      </h2>
      <p class="t-lead">
        {t({
          en: "Audio or video, one file or a whole folder. Click any line to hear it again.",
          it: "Audio o video, un file o un'intera cartella. Fai clic su una riga per riascoltarla.",
        })}
      </p>
    </div>
    <ShotTabs
      name="drop"
      tabs={tabs}
      label={t({ en: "Things people transcribe", it: "Cosa si trascrive" })}
    />
  </div>
</section>

<style>
  .drop {
    background: linear-gradient(180deg, var(--paper) 22%, #e2ebe0 100%);
  }

  .fan {
    position: relative;
    height: 112px;
    margin: 0 auto 28px;
    width: 1px;
  }

  .fan-tile {
    position: absolute;
    left: 0;
    top: 0;
    translate: calc(-50% + var(--x)) var(--y);
    rotate: var(--r);
    transition:
      translate 0.9s var(--ease-out),
      rotate 0.9s var(--ease-out);
    transition-delay: calc(var(--i) * 50ms);
  }

  .fan-tile :global(.doc) {
    width: 72px;
  }

  @media (max-width: 440px) {
    .fan {
      scale: 0.78;
    }
  }

  :global(.js) .fan:not([data-seen]) .fan-tile {
    translate: -50% 18px;
    rotate: 0deg;
  }
</style>
