---
import { faq } from "../../data/faq";
import { translator } from "../../i18n";
import Lines from "../Lines.astro";

const t = translator(Astro.currentLocale);
const questions = t(faq);
const title = t({ en: ["Questions,", "answered."], it: ["Domande", "e risposte."] });
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="narrow">
    <div class="section-head">
      <h2 id="faq-title" class="t-section minor" data-words>
        <Lines lines={title} />
      </h2>
    </div>
    <div class="list">
      {questions.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          {answer.map((block) =>
            "code" in block ? (
              <pre><code>{block.code}</code></pre>
            ) : (
              <p>
                {block.text.map((part) =>
                  typeof part === "string" ? part : <a href={part.href}>{part.label}</a>,
                )}
              </p>
            ),
          )}
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 10px;
  }

  details {
    border-radius: 14px;
    background: var(--mist);
    interpolate-size: allow-keywords;
  }

  summary {
    position: relative;
    display: block;
    padding: 20px 64px 20px 28px;
    font-size: 18px;
    font-weight: 550;
    letter-spacing: -0.012em;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before,
  summary::after {
    content: "";
    position: absolute;
    right: 28px;
    top: 50%;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--sage-deep);
    transition: rotate 0.3s var(--ease-out);
  }

  summary::after {
    rotate: 90deg;
  }

  details[open] summary::after {
    rotate: 0deg;
  }

  details p,
  details pre {
    padding: 0 28px;
    max-width: 44em;
    color: var(--ink-body);
  }

  details p:last-child,
  details pre:last-child {
    padding-bottom: 24px;
  }

  details p + p,
  details p + pre,
  details pre + p {
    margin-top: 12px;
  }

  pre {
    overflow-x: auto;
  }

  code {
    display: inline-block;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-family: var(--font-mono);
    font-size: 14px;
    white-space: pre;
  }

  details a {
    color: var(--sage-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.35s var(--ease-out),
        content-visibility 0.35s allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }
</style>
