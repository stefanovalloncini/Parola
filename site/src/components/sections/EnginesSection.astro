---
import karaokeShot from "../../assets/shots/dark-karaoke.png";
import speakersShot from "../../assets/shots/dark-speakers.png";
import translationShot from "../../assets/shots/dark-translation.png";
import FeatureCard from "../cards/FeatureCard.astro";
import FormatsScene from "../dark/FormatsScene.astro";
import Karaoke from "../dark/Karaoke.astro";
import LanguagesScene from "../dark/LanguagesScene.astro";
import SpeakersScene from "../dark/SpeakersScene.astro";
import FeatureRows, { type FeatureRow } from "../FeatureRows.astro";
import ShotTabs from "../ShotTabs.astro";

const tabs = [
  {
    id: "speakers",
    label: "Speakers",
    image: speakersShot,
    alt: "A meeting transcript in dark mode with three named speakers, each in their own colour.",
  },
  {
    id: "timing",
    label: "Word timing",
    image: karaokeShot,
    alt: "A transcript playing back in dark mode, with the word being spoken highlighted.",
  },
  {
    id: "translation",
    label: "Translation",
    image: translationShot,
    alt: "A transcript in dark mode with its translation shown side by side.",
  },
];

const rows: FeatureRow[] = [
  {
    icon: "wave",
    title: "Apple Speech",
    text: "Built into macOS. Ready the moment you open Parola, with nothing to download.",
  },
  {
    icon: "bubble",
    title: "Whisper",
    text: "OpenAI's Whisper, compiled for Apple silicon. Large v3 Turbo is the best balance for most people.",
  },
  {
    icon: "bolt",
    title: "Parakeet",
    text: "NVIDIA's Parakeet, run through FluidAudio. The fastest multilingual option on Apple silicon.",
  },
  {
    icon: "pencil",
    title: "Edit and fix",
    text: "Edit a line, split or merge segments, and fix a name everywhere with find and replace.",
  },
];
---

<section class="engines section dark" aria-labelledby="engines-title">
  <div class="container">
    <div class="section-head">
      <h2 id="engines-title" class="t-section" data-words>
        Three engines.
        <br />
        Pick the one that fits.
      </h2>
      <p class="t-lead">
        Apple Speech works the moment you open Parola. Whisper and Parakeet download once, then run
        offline.
      </p>
    </div>
    <ShotTabs name="engines" tabs={tabs} label="Transcript views" />

    <div class="grid">
      <FeatureCard
        title="Who said what"
        text="Turn on Diarize and every line gets a speaker. Name them, and a person keeps their name and colour in every transcript you add them to."
      >
        <SpeakersScene />
      </FeatureCard>
      <FeatureCard
        title="Word by word"
        text="The word being spoken lights up as you listen. Click a line to jump straight to it."
      >
        <Karaoke />
      </FeatureCard>
      <FeatureCard
        title="Thirteen formats"
        text="Subtitles, documents or data, from SRT to Final Cut Pro XML. Or burn the captions into a copy of the video."
      >
        <FormatsScene />
      </FeatureCard>
      <FeatureCard
        title="Your language"
        text="Pick one of thirteen languages or let Parola detect it. Parakeet v3 covers 25 European languages."
      >
        <LanguagesScene />
      </FeatureCard>
    </div>
    <FeatureRows rows={rows} />
  </div>
</section>

<style>
  .engines {
    position: relative;
    background:
      radial-gradient(90% 55% at 50% 0%, rgb(63 96 72 / 0.55), transparent 70%),
      linear-gradient(180deg, var(--night) 0%, var(--night-deep) 100%);
    color-scheme: dark;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(64px, 8vw, 104px) 32px;
    margin-top: clamp(96px, 11vw, 160px);
  }

  .engines :global(.stage) {
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 0 0 0 1px rgb(252 242 230 / 0.06);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
