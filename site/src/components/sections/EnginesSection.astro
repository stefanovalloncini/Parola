---
import { localeOf, translator } from "../../i18n";
import FeatureCard from "../cards/FeatureCard.astro";
import FormatsScene from "../dark/FormatsScene.astro";
import Karaoke from "../dark/Karaoke.astro";
import LanguagesScene from "../dark/LanguagesScene.astro";
import SpeakersScene from "../dark/SpeakersScene.astro";
import FeatureRows, { type FeatureRow } from "../FeatureRows.astro";
import Lines from "../Lines.astro";
import ShotTabs, { type ShotTab } from "../ShotTabs.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);

const tabs: ShotTab[] = [
  {
    id: "speakers",
    label: t({ en: "Speakers", it: "Persone" }),
    shot: "dark-speakers",
    alt: t({
      en: "A meeting transcript in dark mode with three named speakers, each in their own color.",
      it: "La trascrizione di una riunione in modalità scura, con tre persone e un colore per ciascuna.",
    }),
  },
  {
    id: "timing",
    label: t({ en: "Word timing", it: "Tempi delle parole" }),
    shot: "dark-karaoke",
    alt: t({
      en: "A transcript playing back in dark mode, with the word being spoken highlighted.",
      it: "Una trascrizione in riproduzione in modalità scura, con la parola pronunciata evidenziata.",
    }),
  },
  {
    id: "translation",
    label: t({ en: "Translation", it: "Traduzione" }),
    shot: "dark-translation",
    alt: t({
      en: "A transcript in dark mode with its translation shown side by side.",
      it: "Una trascrizione in modalità scura con la traduzione affiancata.",
    }),
  },
];

const rows: FeatureRow[] = t({
  en: [
    {
      icon: "wave",
      title: "Apple Speech",
      text: "It's built into macOS, so it works the moment you open Parola. There's nothing to download.",
    },
    {
      icon: "bubble",
      title: "Whisper",
      text: "OpenAI's speech model, compiled for Apple Silicon. Large v3 Turbo is the best balance for most people.",
    },
    {
      icon: "bolt",
      title: "Parakeet",
      text: "NVIDIA's model, running through FluidAudio. It's the fastest multilingual option on Apple Silicon.",
    },
  ],
  it: [
    {
      icon: "wave",
      title: "Apple Speech",
      text: "È integrato in macOS, quindi funziona appena apri Parola. Non c'è niente da scaricare.",
    },
    {
      icon: "bubble",
      title: "Whisper",
      text: "Il modello vocale di OpenAI, compilato per Apple Silicon. Large v3 Turbo è il compromesso migliore per quasi tutti.",
    },
    {
      icon: "bolt",
      title: "Parakeet",
      text: "Il modello di NVIDIA, tramite FluidAudio. È l'opzione multilingue più veloce su Apple Silicon.",
    },
  ],
});

const copy = t({
  en: {
    title: ["Who said what,", "and when."],
    lead: "Speaker labels and word timings come from models running on your Mac.",
    engines: "Three engines. Pick the one that fits.",
    enginesLead:
      "Apple Speech works the moment you open Parola. Whisper and Parakeet download once, then run offline.",
    tabs: "Transcript views",
    speakers: {
      title: "A name for every voice",
      text: "Turn on Diarize and every line gets a speaker. Name them, and a person keeps their name and color in every transcript you add them to.",
    },
    words: {
      title: "Word by word",
      text: "The word being spoken lights up as you listen. Click a line to jump straight to it.",
    },
    formats: {
      title: "Thirteen formats",
      text: "Subtitles, documents or data, including SRT, Word, PDF and Final Cut Pro XML. You can also burn the captions into a copy of the video.",
    },
    languages: {
      title: "Your language",
      text: "Pick one of 13 languages or let Parola detect it. Parakeet v3 covers 25 European languages.",
    },
  },
  it: {
    title: ["Chi ha detto cosa,", "e quando."],
    lead: "I nomi di chi parla e i tempi delle parole vengono da modelli che girano sul tuo Mac.",
    engines: "Tre motori. Scegli quello che fa per te.",
    enginesLead:
      "Apple Speech funziona appena apri Parola. Whisper e Parakeet si scaricano una volta sola, poi lavorano offline.",
    tabs: "Viste della trascrizione",
    speakers: {
      title: "Un nome per ogni voce",
      text: "Attiva Diarizza e ogni riga ha il suo autore. Dai un nome alle persone: nome e colore le seguono in ogni trascrizione a cui le aggiungi.",
    },
    words: {
      title: "Parola per parola",
      text: "La parola pronunciata si illumina mentre ascolti. Fai clic su una riga per saltare lì.",
    },
    formats: {
      title: "Tredici formati",
      text: "Sottotitoli, documenti o dati, tra cui SRT, Word, PDF e Final Cut Pro XML. Puoi anche imprimere i sottotitoli in una copia del video.",
    },
    languages: {
      title: "La tua lingua",
      text: "Scegli una delle 13 lingue o lascia che Parola la riconosca. Parakeet v3 copre 25 lingue europee.",
    },
  },
});
---

<section class="engines section" data-theme="dark" aria-labelledby="engines-title">
  <div class="container">
    <div class="section-head">
      <h2 id="engines-title" class="t-section" data-words>
        <Lines lines={copy.title} />
      </h2>
      <p class="t-lead">{copy.lead}</p>
    </div>
    <ShotTabs name="engines" tabs={tabs} label={copy.tabs} />

    <div class="grid">
      <FeatureCard title={copy.speakers.title} text={copy.speakers.text}>
        <SpeakersScene />
      </FeatureCard>
      <FeatureCard title={copy.words.title} text={copy.words.text}>
        <Karaoke />
      </FeatureCard>
      <FeatureCard title={copy.formats.title} text={copy.formats.text}>
        <FormatsScene />
      </FeatureCard>
      <FeatureCard title={copy.languages.title} text={copy.languages.text}>
        <LanguagesScene />
      </FeatureCard>
    </div>
    <div class="engines-head">
      <h3 class="t-title">{copy.engines}</h3>
      <p class="t-lead">{copy.enginesLead}</p>
    </div>
    <FeatureRows rows={rows} />
  </div>
</section>

<style>
  .engines {
    position: relative;
    background:
      radial-gradient(90% 55% at 50% 0%, rgb(63 96 72 / 0.55), transparent 70%),
      linear-gradient(180deg, var(--night) 0%, var(--night-deep) 100%);
    color-scheme: dark;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(64px, 8vw, 104px) 32px;
    margin-top: clamp(96px, 11vw, 160px);
  }

  .engines-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 16px 32px;
    margin-top: clamp(96px, 11vw, 160px);
  }

  .engines-head .t-lead {
    max-width: 30em;
  }

  .engines-head + :global(.rows) {
    margin-top: 36px;
  }

  .engines :global(.stage) {
    background: rgb(255 255 255 / 0.035);
    box-shadow: inset 0 0 0 1px rgb(252 242 230 / 0.06);
  }

  @media (max-width: 820px) {
    .grid,
    .engines-head {
      grid-template-columns: 1fr;
    }
  }
</style>
