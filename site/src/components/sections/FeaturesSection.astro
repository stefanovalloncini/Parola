---
import CaptionsScene from "../cards/CaptionsScene.astro";
import DictationScene from "../cards/DictationScene.astro";
import FeatureCard from "../cards/FeatureCard.astro";
import LinkScene from "../cards/LinkScene.astro";
import MeetingScene from "../cards/MeetingScene.astro";
import { translator } from "../../i18n";

const t = translator(Astro.currentLocale);

const cards = t({
  en: {
    label: "Recording, dictation and captions",
    meetings: {
      title: "Meetings",
      text: "When Zoom, Teams or Webex opens, Parola offers to record the call. The recording stays on your Mac.",
    },
    dictation: {
      title: "Dictation",
      text: "Turn it on once, then hold F5 and talk. When you let go, the text appears in whatever app you were typing in.",
    },
    captions: {
      title: "Live captions",
      text: "Your words as subtitles, in a panel that stays on top. It can translate them to English as you speak.",
    },
    links: {
      title: "Links",
      text: "Paste a link from YouTube, Vimeo or SoundCloud. Parola fetches the audio and writes it down.",
    },
  },
  it: {
    label: "Registrazione, dettatura e sottotitoli",
    meetings: {
      title: "Riunioni",
      text: "Quando apri Zoom, Teams o Webex, Parola propone di registrare la chiamata. La registrazione resta sul tuo Mac.",
    },
    dictation: {
      title: "Dettatura",
      text: "Attivala una volta, poi tieni premuto F5 e parla. Quando lo rilasci, il testo compare nell'app in cui stavi scrivendo.",
    },
    captions: {
      title: "Sottotitoli in tempo reale",
      text: "Le tue parole come sottotitoli, in un pannello sempre in primo piano. Se vuoi, le traduce in inglese mentre parli.",
    },
    links: {
      title: "Link",
      text: "Incolla un link da YouTube, Vimeo o SoundCloud. Parola scarica l'audio e lo trascrive.",
    },
  },
});
---

<section class="section" aria-labelledby="more-title">
  <div class="container">
    <h2 id="more-title" class="visually-hidden">
      {cards.label}
    </h2>
    <div class="grid">
      <FeatureCard title={cards.meetings.title} text={cards.meetings.text}>
        <MeetingScene />
      </FeatureCard>
      <FeatureCard title={cards.dictation.title} text={cards.dictation.text}>
        <DictationScene />
      </FeatureCard>
      <FeatureCard title={cards.captions.title} text={cards.captions.text}>
        <CaptionsScene />
      </FeatureCard>
      <FeatureCard title={cards.links.title} text={cards.links.text}>
        <LinkScene />
      </FeatureCard>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(64px, 8vw, 104px) 32px;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
