---
import { translator } from "../../i18n";
import DocTile from "../DocTile.astro";

const t = translator(Astro.currentLocale);
---

<span class="dragged" aria-hidden="true">
  <DocTile ext="M4A" />
  <b>+</b>
  <span class="label">{t({ en: "Interview.m4a", it: "Intervista.m4a" })}</span>
</span>

<style>
  .dragged {
    --doc-unit: var(--pt);
    --doc-width: calc(64 * var(--pt));
    position: absolute;
    left: 50%;
    top: calc(430 * var(--pt));
    display: grid;
    justify-items: center;
    gap: calc(6 * var(--pt));
    translate: calc(300 * var(--pt)) calc(300 * var(--pt));
    opacity: 0;
    transition:
      translate 1.1s var(--ease-out) 0.25s,
      opacity 0.3s var(--ease-out) 0.25s;
  }

  .dragged :global(.page) {
    filter: drop-shadow(0 0 0.5px rgb(15 26 20 / 0.4))
      drop-shadow(0 calc(14 * var(--pt)) calc(20 * var(--pt)) rgb(15 26 20 / 0.3));
  }

  .dragged b {
    position: absolute;
    right: calc(-9 * var(--pt));
    top: calc(56 * var(--pt));
    display: grid;
    place-items: center;
    width: calc(24 * var(--pt));
    height: calc(24 * var(--pt));
    border-radius: 50%;
    background: #30d158;
    color: #fff;
    font: 700 calc(18 * var(--pt)) / 1 var(--font-sans);
    box-shadow: 0 0 0 calc(2 * var(--pt)) #fff;
  }

  .label {
    padding: calc(2 * var(--pt)) calc(7 * var(--pt));
    border-radius: calc(5 * var(--pt));
    background: #3478f6;
    color: #fff;
    font: 500 calc(12 * var(--pt)) / 1.3 var(--font-sans);
    white-space: nowrap;
  }

  :global([data-scene="1"]) .dragged {
    translate: calc(-50% + 190 * var(--pt)) calc(-50% + 40 * var(--pt));
    opacity: 1;
  }
</style>
