---
import { Picture } from "astro:assets";
import { shotsFor } from "../../data/shots";
import { localeOf, translator } from "../../i18n";
import Desktop from "../device/Desktop.astro";
import DraggedFile from "./DraggedFile.astro";
import MacBook from "../device/MacBook.astro";
import SceneDictation from "./SceneDictation.astro";
import SceneMeeting from "./SceneMeeting.astro";
import StoryProps from "./StoryProps.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const shots = shotsFor(locale);
const shotSizes = "(min-width: 1600px) 832px, calc(min(860px, 92vw) * 0.8)";

const beats = t({
  en: [
    {
      before: "Audio,",
      mark: "written down",
      punct: ".",
      after: "Right here on your Mac.",
      ownLine: true,
    },
    { before: "Drop in", mark: "any recording", punct: ",", after: "or paste a YouTube link." },
    {
      before: "It records your",
      mark: "meetings",
      punct: "",
      after: "too. No bot joins the call.",
    },
    {
      before: "Hold a key and",
      mark: "speak",
      punct: ".",
      after: "The words land where you type.",
    },
  ],
  it: [
    { before: "Audio,", mark: "in parola", punct: ".", after: "Qui, sul tuo Mac.", ownLine: true },
    {
      before: "Trascina",
      mark: "una registrazione",
      punct: ",",
      after: "o incolla un link di YouTube.",
    },
    {
      before: "Registra anche le tue",
      mark: "riunioni",
      punct: ".",
      after: "Nessun bot si unisce alla chiamata.",
    },
    {
      before: "Tieni premuto un tasto e",
      mark: "parla",
      punct: ".",
      after: "Le parole arrivano dove stai scrivendo.",
    },
  ],
});
---

<section class="story" data-story aria-labelledby="story-title">
  <div class="beats">
    {beats.map((beat, index) => {
      const Tag = index === 0 ? "h1" : "p";
      return (
        <Tag id={index === 0 ? "story-title" : undefined} class="t-hero beat" data-beat>
          {beat.before}{" "}
          <span class="keep">
            <span class="mark">{beat.mark}</span>
            {beat.punct}
          </span>{" "}
          {"ownLine" in beat ? <span class="own-line">{beat.after}</span> : beat.after}
        </Tag>
      );
    })}
  </div>

  <div class="track" aria-hidden="true">
    <div class="fade"></div>
    <div class="device" data-device data-scene="0">
      <StoryProps />
      <MacBook class="laptop">
        <Desktop>
          <div class="scene scene-window">
            <Picture
              src={shots["hero-window"]}
              alt=""
              formats={["avif", "webp"]}
              widths={[720, 1080, 1440, 2160]}
              sizes={shotSizes}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="scene scene-drop">
            <Picture
              src={shots["drop-zone"]}
              alt=""
              formats={["avif", "webp"]}
              widths={[720, 1080, 1440, 2160]}
              sizes={shotSizes}
            />
            <DraggedFile />
          </div>
          <div class="scene scene-call">
            <SceneMeeting />
          </div>
          <div class="scene scene-type">
            <SceneDictation scene={3} />
          </div>
        </Desktop>
      </MacBook>
    </div>
  </div>
</section>

<script>
  import { watchStory } from "../../scripts/story";
  watchStory();
</script>

<style>
  .story {
    --laptop: min(860px, 92vw);
    --device-top: clamp(236px, 37vh, 360px);
    --fade: 24px;
    --band: calc(var(--device-top) - var(--header-height) - var(--fade));
    position: relative;
    overflow: clip;
  }

  .beats {
    position: relative;
    width: min(100% - 2 * var(--gutter), 720px, var(--laptop) - 48px);
    margin-inline: auto;
    padding-bottom: calc(var(--laptop) * 0.7 + 26vh);
    display: grid;
    grid-template-rows: minmax(calc(var(--band) - 4px), auto);
    gap: calc((var(--device-top) - var(--header-height)) * 0.55);
  }

  .beat {
    font-size: min(clamp(40px, 5.2vw + 8px, 68px), calc(var(--band) / 2.9));
    line-height: 0.87;
  }

  .beat:first-child {
    align-self: end;
  }

  .keep {
    white-space: nowrap;
  }

  .own-line {
    display: block;
  }

  @media (max-width: 720px) {
    .story {
      --device-top: clamp(250px, 34vh, 340px);
    }

    .story .track {
      bottom: 132px;
    }
  }

  @media (min-width: 1600px) {
    .story {
      --laptop: min(1040px, 92vw, (100svh - var(--device-top) - 48px) / 0.7);
    }
  }

  .track {
    position: absolute;
    inset: 0 0 96px;
    z-index: 2;
    pointer-events: none;
  }

  .fade {
    position: sticky;
    top: 0;
    height: calc(var(--header-height) + var(--fade));
    margin-top: calc(-1 * var(--header-height));
    background: linear-gradient(var(--paper) calc(100% - var(--fade)), rgb(255 255 255 / 0));
  }

  .device {
    position: sticky;
    top: var(--device-top);
    margin-top: calc(var(--device-top) - var(--header-height) - var(--fade));
  }

  .device::after {
    content: "";
    position: absolute;
    inset: 100% 0 auto;
    height: 100vh;
    background: var(--paper);
  }

  .device :global(.laptop) {
    position: relative;
    z-index: 1;
    width: var(--laptop);
    margin-inline: auto;
  }

  .scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.55s var(--ease-out);
  }

  [data-scene="0"] .scene-window,
  [data-scene="1"] .scene-drop,
  [data-scene="2"] .scene-call,
  [data-scene="3"] .scene-type {
    opacity: 1;
  }

  .scene :global(picture img) {
    position: absolute;
    left: 50%;
    top: calc(100 * var(--pt));
    width: calc(1180 * var(--pt));
    translate: -50% 0;
    filter: drop-shadow(0 calc(12 * var(--pt)) calc(26 * var(--pt)) rgb(0 0 0 / 0.3));
  }

  :global(.js) .beat .mark {
    background-size: 0% 100%;
    color: inherit;
    transition:
      background-size 0.7s var(--ease-out) 0.15s,
      color 0.5s var(--ease-out) 0.15s;
  }

  :global(.js) .beat[data-seen] .mark {
    background-size: 100% 100%;
    color: var(--sage-deep);
  }
</style>
