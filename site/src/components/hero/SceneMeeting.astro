---
import AppWindow from "../device/AppWindow.astro";
import BrandIcon from "../BrandIcon.astro";

const people = [
  { name: "Maya", initials: "M", hue: "#6b8a6b", speaking: true },
  { name: "Tom", initials: "T", hue: "#54739e" },
  { name: "Aiko", initials: "A", hue: "#a07b5a" },
  { name: "Sam", initials: "S", hue: "#7b6f95" },
];
---

<div class="scene-meeting">
  <AppWindow title="Zoom Meeting" tone="dark" class="call">
    <div class="grid">
      {people.map((person) => (
        <div class:list={["tile", { speaking: person.speaking }]} style={`--hue: ${person.hue}`}>
          <span class="avatar">{person.initials}</span>
          <span class="name">{person.name}</span>
        </div>
      ))}
    </div>
    <div class="controls" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <b>Leave</b>
    </div>
  </AppWindow>

  <div class="alert" role="presentation">
    <BrandIcon size={56} class="alert-icon" />
    <p class="alert-title">Zoom is running</p>
    <p class="alert-text">
      Start a system-audio recording? The result lands in your library as a Meeting.
    </p>
    <span class="alert-button primary">Record This Meeting</span>
    <span class="alert-button">Not Now</span>
  </div>
</div>

<style>
  .scene-meeting {
    position: absolute;
    inset: 0;
  }

  .scene-meeting :global(.call) {
    left: calc(250 * var(--pt));
    top: calc(100 * var(--pt));
    width: calc(1012 * var(--pt));
    height: calc(640 * var(--pt));
  }

  .grid {
    position: absolute;
    inset: calc(4 * var(--pt)) calc(12 * var(--pt)) calc(64 * var(--pt));
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(8 * var(--pt));
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: calc(12 * var(--pt));
    background: radial-gradient(
      80% 90% at 50% 30%,
      color-mix(in srgb, var(--hue) 55%, #2a2d2c),
      #1a1c1b 85%
    );
  }

  .tile.speaking {
    box-shadow: inset 0 0 0 calc(3 * var(--pt)) #a9c2a6;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: calc(96 * var(--pt));
    height: calc(96 * var(--pt));
    border-radius: 50%;
    background: var(--hue);
    color: #fff;
    font-size: calc(40 * var(--pt));
    font-weight: 600;
  }

  .name {
    position: absolute;
    left: calc(12 * var(--pt));
    bottom: calc(10 * var(--pt));
    padding: calc(3 * var(--pt)) calc(8 * var(--pt));
    border-radius: calc(6 * var(--pt));
    background: rgb(0 0 0 / 0.45);
    font-size: calc(12 * var(--pt));
    font-weight: 500;
  }

  .controls {
    position: absolute;
    inset: auto 0 0;
    height: calc(64 * var(--pt));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(14 * var(--pt));
  }

  .controls i {
    width: calc(40 * var(--pt));
    height: calc(40 * var(--pt));
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .controls b {
    padding: calc(10 * var(--pt)) calc(18 * var(--pt));
    border-radius: calc(20 * var(--pt));
    background: #d9413d;
    font-size: calc(13 * var(--pt));
    font-weight: 600;
    color: #fff;
  }

  .alert {
    position: absolute;
    left: 50%;
    top: calc(170 * var(--pt));
    width: calc(340 * var(--pt));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(26 * var(--pt)) calc(20 * var(--pt)) calc(20 * var(--pt));
    border-radius: calc(30 * var(--pt));
    background: rgb(244 245 243 / 0.94);
    color: #1d201e;
    text-align: center;
    box-shadow:
      0 0 0 calc(0.6 * var(--pt)) rgb(0 0 0 / 0.14),
      0 calc(20 * var(--pt)) calc(60 * var(--pt)) rgb(0 0 0 / 0.35);
    backdrop-filter: blur(20px);
    translate: -50% 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .alert {
      opacity: 0;
      scale: 0.92;
      transition:
        opacity 0.35s var(--ease-out),
        scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    :global([data-scene="2"]) .alert {
      opacity: 1;
      scale: 1;
      transition-delay: 0.55s;
    }
  }

  .alert :global(.alert-icon) {
    width: calc(72 * var(--pt));
    height: calc(72 * var(--pt));
    margin-bottom: calc(14 * var(--pt));
  }

  .alert-title {
    font-size: calc(18 * var(--pt));
    font-weight: 700;
    margin-bottom: calc(6 * var(--pt));
  }

  .alert-text {
    font-size: calc(14.5 * var(--pt));
    line-height: 1.35;
    margin-bottom: calc(14 * var(--pt));
  }

  .alert-button {
    width: 100%;
    padding: calc(9 * var(--pt)) 0;
    border-radius: calc(15 * var(--pt));
    background: rgb(0 0 0 / 0.07);
    font-size: calc(16 * var(--pt));
    font-weight: 500;
  }

  .alert-button.primary {
    margin-bottom: calc(8 * var(--pt));
    background: #54739e;
    color: #fff;
  }
</style>
