---
import { translator } from "../../i18n";
import DocTile from "../DocTile.astro";

const t = translator(Astro.currentLocale);

const files = [
  {
    ext: "M4A",
    name: t({ en: "Interview.m4a", it: "Intervista.m4a" }),
    tint: "#6b8a6b",
    x: 9,
    y: 16,
    r: -8,
  },
  {
    ext: "MP4",
    name: t({ en: "Lecture 4.mp4", it: "Lezione 4.mp4" }),
    tint: "#54739e",
    x: 13,
    y: 45,
    r: 6,
  },
  {
    ext: "WAV",
    name: t({ en: "Standup.wav", it: "Riunione.wav" }),
    tint: "#a07b5a",
    x: 8,
    y: 72,
    r: -4,
  },
  {
    ext: "MOV",
    name: t({ en: "Keynote.mov", it: "Presentazione.mov" }),
    tint: "#7b6f95",
    x: 13,
    y: 96,
    r: 8,
  },
  {
    ext: "MP3",
    name: t({ en: "Episode 31.mp3", it: "Puntata 31.mp3" }),
    tint: "#3f6048",
    x: 91,
    y: 14,
    r: 7,
  },
  {
    ext: "M4A",
    name: t({ en: "Memo 12 Sept.m4a", it: "Memo 12 set.m4a" }),
    tint: "#6b8a6b",
    x: 87,
    y: 42,
    r: -6,
  },
  {
    ext: "MP4",
    name: t({ en: "Workshop.mp4", it: "Laboratorio.mp4" }),
    tint: "#54739e",
    x: 92,
    y: 70,
    r: 5,
  },
  {
    ext: "OGG",
    name: t({ en: "Voice note.ogg", it: "Nota vocale.ogg" }),
    tint: "#a07b5a",
    x: 87,
    y: 95,
    r: -8,
  },
];

const people = [
  { initials: "M", hue: "#6b8a6b", x: 9, y: 20 },
  { initials: "T", hue: "#54739e", x: 13, y: 55 },
  { initials: "A", hue: "#a07b5a", x: 8, y: 88 },
  { initials: "S", hue: "#7b6f95", x: 91, y: 18 },
  { initials: "J", hue: "#3f6048", x: 87, y: 52 },
  { initials: "R", hue: "#54739e", x: 92, y: 86 },
];

const barCount = 44;
const bars = Array.from({ length: barCount }, (_, i) => {
  const wave = Math.abs(Math.sin(i * 1.7) * 0.55 + Math.sin(i * 0.43) * 0.45);
  return { h: 0.22 + wave * 0.78, fade: 1 - i / barCount, delay: (i * 0.137) % 1.3 };
});
---

<div class="props" aria-hidden="true">
  <div class="set files">
    {files.map((file, i) => (
      <span class="prop" style={`--x: ${file.x}; --y: ${file.y}; --r: ${file.r}deg; --i: ${i}`}>
        <DocTile ext={file.ext} name={file.name} tint={file.tint} />
      </span>
    ))}
  </div>
  <div class="set people">
    {people.map((person, i) => (
      <span
        class="prop person"
        style={`--x: ${person.x}; --y: ${person.y}; --hue: ${person.hue}; --i: ${i}`}
      >
        {person.initials}
      </span>
    ))}
  </div>
  <div class="set stream">
    {["left", "right"].map((side) => (
      <span class:list={["bars", side]}>
        {bars.map((bar) => (
          <i style={`--h: ${bar.h}; --fade: ${bar.fade}; --d: ${bar.delay}s`} />
        ))}
      </span>
    ))}
  </div>
</div>

<style>
  .props {
    --box: calc(var(--laptop) * 1.62);
    --box-h: calc(var(--laptop) * 0.7);
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    width: var(--box);
    height: var(--box-h);
    translate: -50% 0;
    pointer-events: none;
  }

  .set {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .prop {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    translate: -50% -50%;
    rotate: var(--r, 0deg);
    transition:
      translate 0.9s var(--ease-out),
      scale 0.9s var(--ease-out),
      opacity 0.7s var(--ease-out);
    transition-delay: calc(var(--i) * 40ms);
  }

  .files .prop {
    --doc-width: 104px;
  }

  :global([data-scene="0"]) .files,
  :global([data-scene="1"]) .files,
  :global([data-scene="2"]) .people,
  :global([data-scene="3"]) .stream {
    opacity: 1;
  }

  :global([data-scene="1"]) .files .prop {
    translate: calc((50 - var(--x)) * var(--box) / 100 - 50%)
      calc((40 - var(--y)) * var(--box-h) / 100 - 50%);
    scale: 0.35;
    opacity: 0;
  }

  .person {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--hue);
    color: #fff;
    font: 600 24px var(--font-display);
    box-shadow: 0 10px 24px -10px rgb(15 26 20 / 0.5);
  }

  .person::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--hue);
    opacity: 0;
  }

  .bars {
    position: absolute;
    top: 47%;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 72px;
    translate: 0 -50%;
  }

  .bars.left {
    right: calc(50% + var(--laptop) / 2 + 14px);
    flex-direction: row-reverse;
  }

  .bars.right {
    left: calc(50% + var(--laptop) / 2 + 14px);
  }

  .bars i {
    flex: none;
    width: 7px;
    height: calc(var(--h) * 100%);
    border-radius: 4px;
    background: var(--sage);
    opacity: calc(0.15 + var(--fade) * 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .files .prop :global(.doc) {
      animation: drift 7s var(--ease-in-out) infinite alternate;
      animation-delay: calc(var(--i) * -0.9s);
    }

    .person::after {
      animation: speak 2.4s var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 0.4s);
    }

    :global([data-scene="3"]) .bars i {
      animation: pulse 1.3s var(--ease-in-out) infinite alternate;
      animation-delay: calc(var(--d) * -1);
    }

    :global([data-story]:not([data-active])) .props * {
      animation-play-state: paused;
    }
  }

  @keyframes drift {
    to {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @keyframes speak {
    0% {
      opacity: 0.7;
      scale: 0.9;
    }
    100% {
      opacity: 0;
      scale: 1.25;
    }
  }

  @keyframes pulse {
    to {
      transform: scaleY(0.3);
    }
  }

  @media (max-width: 1100px) {
    .files,
    .people {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .stream {
      display: none;
    }
  }
</style>
