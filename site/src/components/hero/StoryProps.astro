---
import { propsFor } from "../../data/story";
import { localeOf } from "../../i18n";
import DocTile from "../DocTile.astro";

const { files, people } = propsFor(localeOf(Astro.currentLocale));
const barCount = 44;
const bars = Array.from({ length: barCount }, (_, i) => {
  const wave = Math.abs(Math.sin(i * 1.7) * 0.55 + Math.sin(i * 0.43) * 0.45);
  return { h: 0.22 + wave * 0.78, fade: 1 - i / barCount, delay: (i * 0.137) % 1.3 };
});
---

<div class="props" aria-hidden="true">
  <div class="set files">
    {files.map((file, i) => (
      <span class="prop" style={`--x: ${file.x}; --y: ${file.y}; --r: ${file.r}deg; --i: ${i}`}>
        <DocTile ext={file.ext} name={file.name} tint={file.tint} />
      </span>
    ))}
  </div>
  <div class="set people">
    {people.map((person, i) => (
      <span
        class="prop person"
        style={`--x: ${person.x}; --y: ${person.y}; --hue: ${person.hue}; --i: ${i}`}
      >
        {person.initials}
      </span>
    ))}
  </div>
  <div class="set stream">
    {["left", "right"].map((side) => (
      <span class:list={["bars", side]}>
        {bars.map((bar) => (
          <i style={`--h: ${bar.h}; --fade: ${bar.fade}; --d: ${bar.delay}s`} />
        ))}
      </span>
    ))}
  </div>
</div>

<style>
  .props {
    --box: calc(var(--laptop) * 1.62);
    --box-h: calc(var(--laptop) * 0.7);
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    width: var(--box);
    height: var(--box-h);
    translate: -50% 0;
    pointer-events: none;
  }

  .set {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .prop {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    translate: -50% -50%;
    rotate: var(--r, 0deg);
    transition:
      translate 0.9s var(--ease-out),
      scale 0.9s var(--ease-out),
      opacity 0.7s var(--ease-out);
    transition-delay: calc(var(--i) * 40ms);
  }

  .files .prop {
    --doc-width: 104px;
  }

  :global([data-scene="0"]) .files,
  :global([data-scene="1"]) .files,
  :global([data-scene="2"]) .people,
  :global([data-scene="3"]) .stream {
    opacity: 1;
  }

  :global([data-scene="1"]) .files .prop {
    translate: calc((50 - var(--x)) * var(--box) / 100 - 50%)
      calc((40 - var(--y)) * var(--box-h) / 100 - 50%);
    scale: 0.35;
    opacity: 0;
  }

  .person {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--hue);
    color: #fff;
    font: 600 24px var(--font-display);
    box-shadow: 0 10px 24px -10px rgb(15 26 20 / 0.5);
  }

  .person::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--hue);
    opacity: 0;
  }

  .bars {
    position: absolute;
    top: 47%;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 72px;
    translate: 0 -50%;
  }

  .bars.left {
    right: calc(50% + var(--laptop) / 2 + 14px);
    flex-direction: row-reverse;
  }

  .bars.right {
    left: calc(50% + var(--laptop) / 2 + 14px);
  }

  .bars i {
    flex: none;
    width: 7px;
    height: calc(var(--h) * 100%);
    border-radius: 4px;
    background: var(--sage);
    opacity: calc(0.15 + var(--fade) * 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .files .prop :global(.doc) {
      animation: drift 7s var(--ease-in-out) infinite alternate;
      animation-delay: calc(var(--i) * -0.9s);
    }

    .person::after {
      animation: speak 2.4s var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 0.4s);
    }

    :global([data-scene="3"]) .bars i {
      animation: pulse 1.3s var(--ease-in-out) infinite alternate;
      animation-delay: calc(var(--d) * -1);
    }

    :global([data-story]:not([data-active])) .props * {
      animation-play-state: paused;
    }
  }

  @keyframes drift {
    to {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @keyframes speak {
    0% {
      opacity: 0.7;
      scale: 0.9;
    }
    100% {
      opacity: 0;
      scale: 1.25;
    }
  }

  @keyframes pulse {
    to {
      transform: scaleY(0.3);
    }
  }

  @media (max-width: 1100px) {
    .files,
    .people {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .stream {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .props {
      top: calc(100% + 30px);
      width: 100%;
      height: 84px;
    }

    .props .set {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
    }

    .prop {
      position: relative;
      left: auto;
      top: auto;
      translate: 0 0;
    }

    .files .prop {
      --doc-width: 50px;
    }

    .files .prop:nth-child(n + 6),
    .person:nth-child(n + 6),
    .bars i:nth-child(n + 15) {
      display: none;
    }

    .files .prop :global(.name) {
      display: none;
    }

    :global([data-scene="1"]) .files .prop {
      translate: 0 -120px;
      scale: 0.4;
      opacity: 0;
    }

    .person {
      width: 46px;
      height: 46px;
      font-size: 18px;
    }

    .stream {
      gap: 5px;
    }

    .bars {
      position: static;
      gap: 5px;
      height: 56px;
      translate: 0 0;
    }

    .bars i {
      width: 5px;
    }
  }
</style>
