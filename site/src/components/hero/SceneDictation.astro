---
import AppWindow from "../device/AppWindow.astro";

const typed = "Thanks for today. I'll send the notes by Friday and book the review for Tuesday.";
const levels = [0.35, 0.7, 1, 0.55, 0.85, 0.45, 0.75];
---

<div class="scene-dictation" data-typewriter>
  <AppWindow title="Re: Launch review" class="editor">
    <div class="fields" aria-hidden="true">
      <p>
        <span>To:</span> Maya Chen
      </p>
      <p>
        <span>Subject:</span> Launch review
      </p>
    </div>
    <div class="page">
      <p>Hi Maya,</p>
      <p>
        <span data-typed data-text={typed}>
          {typed}
        </span>
        <i class="caret"></i>
      </p>
      <div class="pill" aria-hidden="true">
        <span class="pill-row">
          <span class="bars">
            {levels.map((level, i) => (
              <i style={`--l: ${level}; --i: ${i}`} />
            ))}
          </span>
          <span class="label">Listening</span>
          <span class="stop">
            <i></i>
          </span>
        </span>
        <span class="partial" data-partial>
          book the review for Tuesday.
        </span>
      </div>
    </div>
  </AppWindow>
</div>

<script>
  import { typeOnScene } from "../../scripts/typewriter";
  document
    .querySelectorAll<HTMLElement>("[data-typewriter]")
    .forEach((root) => typeOnScene(root, "3"));
</script>

<style>
  .scene-dictation {
    position: absolute;
    inset: 0;
  }

  .scene-dictation :global(.editor) {
    left: calc(300 * var(--pt));
    top: calc(128 * var(--pt));
    width: calc(912 * var(--pt));
    height: calc(620 * var(--pt));
  }

  .fields {
    border-block: calc(0.6 * var(--pt)) solid rgb(0 0 0 / 0.08);
    font-size: calc(16 * var(--pt));
  }

  .fields p {
    padding: calc(8 * var(--pt)) calc(24 * var(--pt));
  }

  .fields p + p {
    border-top: calc(0.6 * var(--pt)) solid rgb(0 0 0 / 0.08);
  }

  .fields span {
    color: #8a8f8c;
    margin-right: calc(6 * var(--pt));
  }

  .page {
    position: relative;
    padding: calc(26 * var(--pt)) calc(24 * var(--pt));
    font-size: calc(22 * var(--pt));
    line-height: 1.45;
  }

  .page p + p {
    margin-top: calc(14 * var(--pt));
  }

  .caret {
    display: inline-block;
    width: calc(1.6 * var(--pt));
    height: 1.15em;
    margin-left: calc(1 * var(--pt));
    vertical-align: text-bottom;
    background: #54739e;
  }

  .pill {
    position: absolute;
    left: calc(24 * var(--pt));
    top: calc(170 * var(--pt));
    width: calc(470 * var(--pt));
    padding: calc(11 * var(--pt)) calc(16 * var(--pt));
    border-radius: calc(19 * var(--pt));
    background: rgb(0 0 0 / 0.88);
    box-shadow:
      inset 0 0 0 calc(1 * var(--pt)) rgb(255 255 255 / 0.08),
      0 calc(10 * var(--pt)) calc(26 * var(--pt)) rgb(0 0 0 / 0.3);
    color: rgb(255 255 255 / 0.9);
    font-size: calc(15 * var(--pt));
    line-height: 1.3;
  }

  .pill-row {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--pt));
    height: calc(30 * var(--pt));
  }

  .bars {
    display: flex;
    align-items: center;
    gap: calc(2 * var(--pt));
    width: calc(32 * var(--pt));
    height: calc(21 * var(--pt));
  }

  .bars i {
    flex: 1;
    height: calc(var(--l) * 100%);
    border-radius: calc(2 * var(--pt));
    background: #fff;
  }

  .label {
    flex: 1;
  }

  .stop {
    display: grid;
    place-items: center;
    width: calc(29 * var(--pt));
    height: calc(29 * var(--pt));
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .stop i {
    width: calc(9 * var(--pt));
    height: calc(9 * var(--pt));
    border-radius: calc(2 * var(--pt));
    background: #fff;
  }

  .partial {
    display: block;
    margin-top: calc(4 * var(--pt));
    color: rgb(255 255 255 / 0.85);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-scene="3"]) .bars i {
      animation: level 0.9s var(--ease-in-out) infinite alternate;
      animation-delay: calc(var(--i) * -0.23s);
    }

    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes level {
    to {
      transform: scaleY(0.35);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
