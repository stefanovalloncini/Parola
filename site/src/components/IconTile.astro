---
import { hues, type GlyphName, type Hue } from "../data/icons";
import { marks, type MarkName } from "../data/marks";
import Icon from "./Icon.astro";

export type TileArt = { glyph: GlyphName; hue: Hue } | { mark: MarkName };

type Props = TileArt & { size: string; class?: string };

const props = Astro.props;
const style =
  "mark" in props
    ? `--size: ${props.size}; --scale: ${marks[props.mark].scale}; background: ${marks[props.mark].background}; color: ${marks[props.mark].color}`
    : `--size: ${props.size}; --top: ${hues[props.hue].top}; --bottom: ${hues[props.hue].bottom}`;
---

<span
  class:list={["tile", { mark: "mark" in props }, props.class]}
  style={style}
  data-tile={"mark" in props ? props.mark : props.glyph}
  aria-hidden="true"
>
  {"mark" in props ? (
    <svg
      viewBox={marks[props.mark].viewBox}
      fill="currentColor"
      fill-rule={marks[props.mark].fillRule}
      aria-hidden="true"
      focusable="false"
      set:html={marks[props.mark].body}
    />
  ) : (
    <Icon name={props.glyph} />
  )}
</span>

<style>
  .tile {
    position: relative;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.24);
    background: linear-gradient(var(--top), var(--bottom));
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 0 0 0 0.5px rgb(0 0 0 / 0.12),
      0 1px 2px rgb(15 26 20 / 0.14),
      0 2px 6px -2px rgb(15 26 20 / 0.2);
  }

  .tile > :global(svg) {
    position: relative;
    z-index: 1;
    width: 60%;
    height: 60%;
  }

  .mark > :global(svg) {
    width: calc(var(--scale) * 100%);
    height: calc(var(--scale) * 100%);
  }

  @supports (corner-shape: squircle) {
    .tile {
      corner-shape: squircle;
      border-radius: calc(var(--size) * 0.36);
    }
  }

  :global([data-theme="dark"]) .tile {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.32),
      inset 0 0 0 0.5px rgb(255 255 255 / 0.1),
      0 0 0 0.5px rgb(0 0 0 / 0.5),
      0 4px 12px -4px rgb(0 0 0 / 0.8);
  }
</style>
