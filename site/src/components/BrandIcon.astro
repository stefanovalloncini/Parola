---
import { brandBars, nib, type Mark } from "../data/brand";

interface Props {
  size?: number;
  class?: string;
  mark?: Mark;
}

const { size = 32, class: className, mark = "pennino" } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="100 100 824 824"
  aria-hidden="true"
  focusable="false"
>
  <rect x="100" y="100" width="824" height="824" rx="181.3" fill="#6b8a6b"></rect>
  {brandBars(mark).map((bar) => (
    <rect
      x={bar.x}
      y={bar.y}
      width={bar.width}
      height={bar.height}
      rx={bar.width / 2}
      fill="#fcf2e6"
    />
  ))}
  {mark === "pennino" && (
    <g>
      <path d={nib.outline} fill="#e8b861" />
      <circle cx={nib.hole.cx} cy={nib.hole.cy} r={nib.hole.r} fill="#6b8a6b" />
      <rect
        x={nib.slit.x}
        y={nib.slit.y}
        width={nib.slit.width}
        height={nib.slit.height}
        fill="#6b8a6b"
      />
    </g>
  )}
</svg>
