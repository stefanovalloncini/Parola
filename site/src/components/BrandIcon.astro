---
import { brandBars } from "../data/brand";

interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="100 100 824 824"
  aria-hidden="true"
  focusable="false"
>
  <rect x="100" y="100" width="824" height="824" rx="181.3" fill="#6b8a6b"></rect>
  {brandBars.map((bar) => (
    <rect
      x={bar.x}
      y={bar.y}
      width={bar.width}
      height={bar.height}
      rx={bar.width / 2}
      fill="#fcf2e6"
    />
  ))}
</svg>
