---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
}

const { light, dark, widths, sizes, loading = "lazy", fetchpriority = "auto" } = Astro.props;
const sets = (image: ImageMetadata) =>
  Promise.all(
    (["avif", "webp"] as const).map((format) =>
      getImage({ src: image, format, widths: widths.filter((width) => width <= image.width) }),
    ),
  );
const [darkSets, lightSets] = await Promise.all([sets(dark), sets(light)]);
---

<picture>
  {darkSets.map((set) => (
    <source
      media="(prefers-color-scheme: dark)"
      type={`image/${set.options.format}`}
      srcset={set.srcSet.attribute}
      sizes={sizes}
    />
  ))}
  {lightSets.map((set) => (
    <source type={`image/${set.options.format}`} srcset={set.srcSet.attribute} sizes={sizes} />
  ))}
  <img
    src={lightSets[1]?.src}
    width={light.width}
    height={light.height}
    alt=""
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
