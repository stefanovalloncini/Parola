---
import { links } from "../data/links";
import { localeOf, pathFor, translator } from "../i18n";
import BrandIcon from "./BrandIcon.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const other = locale === "it" ? "en" : "it";
const path = Astro.url.pathname;
const missing = pathFor("en", path).startsWith("/404");
const switchTo = pathFor(other, missing ? "/" : path);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="maker">
      <BrandIcon size={40} />
      <p>
        {t({ en: "Made by Stefano Valloncini.", it: "Fatto da Stefano Valloncini." })}
        <br />
        <span>
          {t({
            en: "Parola is free software under the MIT license.",
            it: "Parola è software libero con licenza MIT.",
          })}
        </span>
      </p>
    </div>
    <nav class="footer-links" aria-label={t({ en: "Footer", it: "Piè di pagina" })}>
      <a href={links.repository}>GitHub</a>
      <a href={links.releases}>{t({ en: "Releases", it: "Versioni" })}</a>
      <a href={pathFor(locale, "/privacy/")}>Privacy</a>
      <a href={`mailto:${links.feedbackEmail}?subject=Parola`}>
        {t({ en: "Contact", it: "Contatti" })}
      </a>
      <a href={switchTo} hreflang={other} lang={other}>
        {other === "it" ? "Italiano" : "English"}
      </a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>
      {t({
        en: "This website sets no cookies and loads nothing from other servers.",
        it: "Questo sito non usa cookie e non carica nulla da altri server.",
      })}
    </p>
    <p>&copy; {year} Stefano Valloncini</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--mist);
    border-top: 0.5px solid var(--hairline);
    padding-block: 44px 36px;
    font-size: 15px;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 28px;
    border-bottom: 0.5px solid var(--hairline);
  }

  .maker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    line-height: 1.35;
  }

  .maker span {
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer-links a {
    color: var(--muted);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
