---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["macbook", className]}>
  <div class="lid">
    <div class="screen">
      <slot />
    </div>
    <span class="notch" aria-hidden="true"></span>
  </div>
  <div class="base" aria-hidden="true">
    <span class="scoop"></span>
  </div>
</div>

<style>
  .macbook {
    position: relative;
    width: 100%;
  }

  .lid {
    position: relative;
    padding: 1.55% 1.55% 2%;
    border-radius: 2.6% / 4%;
    background: linear-gradient(180deg, #1c1d20, #0c0d0f 12%);
    box-shadow:
      inset 0 0 0 1px #3a3b40,
      inset 0 0 0 2.5px #0a0a0c,
      0 0 0 0.5px rgb(0 0 0 / 0.55);
  }

  .screen {
    position: relative;
    aspect-ratio: 1512 / 982;
    overflow: hidden;
    border-radius: 1.1% / 1.7%;
    background: #1b261f;
    container-type: inline-size;
  }

  .notch {
    position: absolute;
    top: 1.55%;
    left: 50%;
    width: 10.5%;
    height: 3.1%;
    transform: translateX(-50%);
    border-radius: 0 0 9px 9px / 0 0 8px 8px;
    background: #0a0a0c;
  }

  .notch::after {
    content: "";
    position: absolute;
    top: 38%;
    left: 50%;
    width: 7%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3a4f, #0b0f16 70%);
  }

  .base {
    position: relative;
    width: 117%;
    margin-left: -8.5%;
    height: 0;
    padding-bottom: 2.9%;
    border-radius: 0 0 26px 26px / 0 0 18px 18px;
    background: linear-gradient(180deg, #4a4b50 0%, #26272b 22%, #151619 70%, #0c0c0e 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 22px 40px -18px rgb(15 26 20 / 0.55);
  }

  .base::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -22px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(15 26 20 / 0.22), transparent);
    filter: blur(6px);
    z-index: -1;
  }

  @media (max-width: 1000px) {
    .base {
      width: 106%;
      margin-left: -3%;
    }
  }

  .scoop {
    position: absolute;
    top: 0;
    left: 50%;
    width: 15%;
    height: 42%;
    transform: translateX(-50%);
    border-radius: 0 0 14px 14px / 0 0 10px 10px;
    background: linear-gradient(180deg, #111214, #2a2b2f);
  }
</style>
