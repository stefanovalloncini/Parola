---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["macbook", className]}>
  <div class="lid">
    <div class="screen">
      <slot />
    </div>
    <span class="notch" aria-hidden="true"></span>
  </div>
  <div class="base" aria-hidden="true">
    <span class="scoop"></span>
    <span class="foot left"></span>
    <span class="foot right"></span>
  </div>
</div>

<style>
  .macbook {
    position: relative;
    width: 100%;
  }

  .lid {
    position: relative;
    padding: 1.55% 1.55% 2%;
    border-radius: 2.6% / 4%;
    background: linear-gradient(180deg, #1c1d20, #0c0d0f 12%);
    box-shadow:
      inset 0 0 0 1px #8e8f94,
      inset 0 0 0 2.5px #121315,
      0 0 0 0.5px rgb(0 0 0 / 0.55);
  }

  .screen {
    position: relative;
    aspect-ratio: 1512 / 982;
    overflow: hidden;
    border-radius: 1.1% / 1.7%;
    background: #1b261f;
    container-type: inline-size;
  }

  .notch {
    position: absolute;
    top: 1.55%;
    left: 50%;
    width: 10.5%;
    height: 3.1%;
    transform: translateX(-50%);
    border-radius: 0 0 9px 9px / 0 0 8px 8px;
    background: #0a0a0c;
  }

  .notch::after {
    content: "";
    position: absolute;
    top: 38%;
    left: 50%;
    width: 7%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3a4f, #0b0f16 70%);
  }

  .base {
    position: relative;
    width: 117%;
    margin-left: -8.5%;
    height: 0;
    padding-bottom: 2.9%;
    border-radius: 0 0 26px 26px / 0 0 18px 18px;
    background: linear-gradient(180deg, #a3a4a9 0%, #6d6e73 14%, #4b4c51 38%, #2c2d31 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      inset 0 -1px 0 rgb(0 0 0 / 0.35),
      0 22px 40px -18px rgb(15 26 20 / 0.55);
  }

  .base::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -22px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(15 26 20 / 0.22), transparent);
    filter: blur(6px);
    z-index: -1;
  }

  @media (max-width: 1000px) {
    .base {
      width: 106%;
      margin-left: -3%;
    }
  }

  .scoop {
    position: absolute;
    top: 0;
    left: 50%;
    width: 15%;
    height: 42%;
    transform: translateX(-50%);
    border-radius: 0 0 14px 14px / 0 0 10px 10px;
    background: linear-gradient(180deg, #3a3b3f, #6a6b70);
    box-shadow: inset 0 1px 1px rgb(0 0 0 / 0.35);
  }

  .foot {
    position: absolute;
    bottom: -3px;
    width: 9%;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: #1f2023;
  }

  .foot.left {
    left: 9%;
  }

  .foot.right {
    right: 9%;
  }

  @media (prefers-color-scheme: dark) {
    .lid {
      box-shadow:
        inset 0 0 0 1px #8e8f94,
        inset 0 0 0 2.5px #121315,
        0 0 0 0.5px rgb(255 255 255 / 0.12);
    }
  }
</style>
