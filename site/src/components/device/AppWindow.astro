---
interface Props {
  title?: string;
  tone?: "light" | "dark";
  class?: string;
}

const { title, tone = "light", class: className } = Astro.props;
---

<div class:list={["app-window", className]} data-tone={tone}>
  <div class="titlebar">
    <span class="lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    {title && <span class="title">{title}</span>}
    <slot name="toolbar" />
  </div>
  <div class="body">
    <slot />
  </div>
</div>

<style>
  .app-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: calc(14 * var(--pt));
    background: #fbfbfa;
    color: #1d201e;
    box-shadow:
      0 0 0 calc(0.6 * var(--pt)) rgb(0 0 0 / 0.18),
      0 calc(10 * var(--pt)) calc(40 * var(--pt)) rgb(0 0 0 / 0.3);
  }

  .app-window[data-tone="dark"] {
    background: #202222;
    color: #eceeed;
    box-shadow:
      0 0 0 calc(0.6 * var(--pt)) rgb(0 0 0 / 0.6),
      inset 0 0 0 calc(0.6 * var(--pt)) rgb(255 255 255 / 0.1),
      0 calc(10 * var(--pt)) calc(40 * var(--pt)) rgb(0 0 0 / 0.4);
  }

  .titlebar {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--pt));
    height: calc(38 * var(--pt));
    padding-inline: calc(14 * var(--pt));
    font-size: calc(13 * var(--pt));
    font-weight: 600;
  }

  .lights {
    display: flex;
    gap: calc(8 * var(--pt));
  }

  .lights i {
    width: calc(12 * var(--pt));
    height: calc(12 * var(--pt));
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 calc(0.5 * var(--pt)) rgb(0 0 0 / 0.15);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.85;
  }

  .body {
    position: relative;
    flex: 1;
    min-height: 0;
  }
</style>
