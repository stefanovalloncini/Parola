---
import { glyph, type GlyphName } from "../data/icons";

interface Props {
  name: GlyphName;
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={glyph(name)}
/>
