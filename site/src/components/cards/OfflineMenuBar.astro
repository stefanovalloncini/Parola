---
import Icon from "../Icon.astro";

interface Props {
  menus: readonly string[];
}

const { menus } = Astro.props;
---

<div class="menubar">
  <b>Parola</b>
  {menus.map((menu) => (
    <span>{menu}</span>
  ))}
  <span class="status">
    <span class="wifi">
      <Icon name="wifi-high" class="on" />
      <Icon name="wifi-slash" class="off" />
    </span>
    <span>9:41</span>
  </span>
</div>

<style>
  .menubar {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--u));
    height: calc(28 * var(--u));
    padding-inline: calc(16 * var(--u));
    background: rgb(255 255 255 / 0.55);
    color: #1d201e;
    font-size: max(11px, calc(12 * var(--u)));
  }
  .status {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--u));
    margin-left: auto;
  }
  .wifi {
    display: grid;
  }
  .wifi :global(svg) {
    grid-area: 1 / 1;
    width: calc(17 * var(--u));
    height: calc(17 * var(--u));
  }
  .wifi :global(.off) {
    opacity: 0;
  }

  :global(:is([data-state="off"], [data-state="working"], [data-state="done"])) .wifi :global(.on) {
    opacity: 0;
  }

  :global(:is([data-state="off"], [data-state="working"], [data-state="done"]))
    .wifi
    :global(.off) {
    opacity: 1;
  }
</style>
