---
import { translator } from "../../i18n";

const t = translator(Astro.currentLocale);
const tiles = [
  { initials: t({ en: "M", it: "G" }), hue: "#6b8a6b" },
  { initials: t({ en: "T", it: "L" }), hue: "#54739e" },
  { initials: t({ en: "A", it: "S" }), hue: "#a07b5a" },
  { initials: t({ en: "S", it: "M" }), hue: "#7b6f95" },
];
---

<div class="call">
  <div class="strip">
    {tiles.map((tile, i) => (
      <span class:list={["tile", { talking: i === 0 }]} style={`--hue: ${tile.hue}`}>
        <b>{tile.initials}</b>
      </span>
    ))}
  </div>
  <div class="shared">
    <p>{t({ en: "Q3 plan", it: "Piano Q3" })}</p>
    <span class="bars">
      <i style="--h: .4"></i>
      <i style="--h: .65"></i>
      <i style="--h: .5"></i>
      <i style="--h: .85"></i>
    </span>
  </div>
</div>

<style>
  .call {
    position: absolute;
    left: calc(34 * var(--u));
    right: calc(34 * var(--u));
    top: calc(46 * var(--u));
    height: calc(290 * var(--u));
    display: grid;
    grid-template-rows: auto 1fr;
    gap: calc(6 * var(--u));
    padding: calc(26 * var(--u)) calc(8 * var(--u)) calc(8 * var(--u));
    border-radius: calc(12 * var(--u));
    background: #1d1f1e;
    box-shadow: 0 calc(14 * var(--u)) calc(30 * var(--u)) rgb(0 0 0 / 0.3);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: calc(5 * var(--u));
  }

  .tile {
    display: grid;
    place-items: center;
    height: calc(52 * var(--u));
    border-radius: calc(7 * var(--u));
    background: radial-gradient(
      90% 90% at 50% 35%,
      color-mix(in srgb, var(--hue) 45%, #2a2d2c),
      #181a19
    );
  }

  .tile.talking {
    box-shadow: inset 0 0 0 calc(2 * var(--u)) var(--sage-soft);
  }

  .tile b {
    display: grid;
    place-items: center;
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
    border-radius: 50%;
    background: var(--hue);
    color: #fff;
    font-size: calc(13 * var(--u));
    font-weight: 600;
  }

  .shared {
    position: relative;
    border-radius: calc(7 * var(--u));
    background: linear-gradient(150deg, #f7f5ef, #e7ece4);
    padding: calc(16 * var(--u)) calc(12 * var(--u));
  }

  .shared p {
    font-family: var(--font-display);
    font-size: calc(15 * var(--u));
    font-weight: 700;
    color: #2c3530;
  }

  .shared .bars {
    position: absolute;
    left: calc(12 * var(--u));
    right: calc(12 * var(--u));
    bottom: calc(12 * var(--u));
    height: calc(110 * var(--u));
    display: flex;
    align-items: flex-end;
    gap: calc(12 * var(--u));
  }

  .shared .bars i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: calc(5 * var(--u)) calc(5 * var(--u)) 0 0;
    background: var(--sage);
    opacity: 0.85;
  }
</style>
