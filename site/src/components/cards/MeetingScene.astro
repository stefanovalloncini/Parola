---
import { translator } from "../../i18n";
import BrandIcon from "../BrandIcon.astro";
import CallWindow from "./CallWindow.astro";

const t = translator(Astro.currentLocale);

const steps = [
  [0, "idle"],
  [700, "alert"],
  [2900, "press"],
  [3300, "recording"],
];
---

<div
  class="meeting"
  data-scene-loop={JSON.stringify(steps)}
  data-duration="7600"
  data-still="alert"
  data-state="alert"
  aria-hidden="true"
>
  <CallWindow />
  <div class="alert">
    <BrandIcon size={40} class="icon" />
    <p class="title">{t({ en: "Zoom is running", it: "Zoom è in esecuzione" })}</p>
    <p class="text">
      {t({
        en: "Start a system-audio recording? The result lands in your library as a Meeting.",
        it: "Avviare una registrazione dell'audio di sistema? Finirà in libreria, tra le Riunioni.",
      })}
    </p>
    <span class="button primary">
      {t({ en: "Record This Meeting", it: "Registra questa riunione" })}
    </span>
    <span class="button">{t({ en: "Not Now", it: "Non ora" })}</span>
  </div>
  <div class="dock">
    <span class="app"></span>
    <span class="app"></span>
    <span class="parola">
      <BrandIcon size={34} />
      <b class="badge"></b>
    </span>
    <span class="app"></span>
  </div>
</div>

<style>
  .meeting {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 70% at 90% 0%, rgb(252 242 230 / 0.9), transparent 70%),
      radial-gradient(80% 80% at 0% 100%, #365342, transparent 70%),
      linear-gradient(160deg, #b9cfb5, #6f8f6e 60%, #4a6b51);
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: calc(14 * var(--u));
    display: flex;
    gap: calc(8 * var(--u));
    padding: calc(7 * var(--u));
    border-radius: calc(16 * var(--u));
    background: rgb(255 255 255 / 0.32);
    box-shadow: inset 0 0 0 calc(0.6 * var(--u)) rgb(255 255 255 / 0.5);
    translate: -50% 0;
  }

  .app,
  .parola :global(svg) {
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
  }

  .app {
    border-radius: calc(9 * var(--u));
    background: linear-gradient(160deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.45));
  }

  .parola {
    position: relative;
  }

  .badge {
    position: absolute;
    top: calc(-6 * var(--u));
    right: calc(-10 * var(--u));
    padding: calc(1.5 * var(--u)) calc(5 * var(--u));
    border-radius: 999px;
    background: var(--record);
    color: #fff;
    font-size: calc(9.5 * var(--u));
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    counter-reset: seconds var(--seconds);
    opacity: 0;
    scale: 0.6;
  }

  .alert {
    position: absolute;
    left: 50%;
    top: calc(96 * var(--u));
    width: calc(236 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(18 * var(--u)) calc(14 * var(--u)) calc(14 * var(--u));
    border-radius: calc(22 * var(--u));
    background: #f4f5f3;
    text-align: center;
    color: #1d201e;
    box-shadow:
      0 0 0 calc(0.6 * var(--u)) rgb(0 0 0 / 0.12),
      0 calc(18 * var(--u)) calc(40 * var(--u)) rgb(0 0 0 / 0.32);
    translate: -50% 0;
    opacity: 0;
    scale: 0.9;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .alert :global(.icon) {
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    margin-bottom: calc(9 * var(--u));
  }

  .title {
    font-size: calc(13 * var(--u));
    font-weight: 700;
  }

  .text {
    margin: calc(5 * var(--u)) 0 calc(11 * var(--u));
    font-size: calc(10.5 * var(--u));
    line-height: 1.35;
  }

  .button {
    width: 100%;
    padding: calc(6 * var(--u)) 0;
    border-radius: calc(11 * var(--u));
    background: rgb(0 0 0 / 0.07);
    font-size: calc(11.5 * var(--u));
    font-weight: 500;
    transition:
      scale 0.15s,
      filter 0.15s;
  }

  .button.primary {
    margin-bottom: calc(6 * var(--u));
    background: #54739e;
    color: #fff;
  }

  [data-state="alert"] .alert,
  [data-state="press"] .alert {
    opacity: 1;
    scale: 1;
  }

  [data-state="press"] .primary {
    scale: 0.96;
    filter: brightness(0.86);
  }

  .badge::after {
    content: "0:0" counter(seconds);
  }

  [data-state="recording"] .badge {
    opacity: 1;
    scale: 1;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: meeting-seconds 4s steps(4, jump-none) forwards;
  }

  @property --seconds {
    syntax: "<integer>";
    inherits: false;
    initial-value: 1;
  }

  @keyframes meeting-seconds {
    to {
      --seconds: 4;
    }
  }
</style>
