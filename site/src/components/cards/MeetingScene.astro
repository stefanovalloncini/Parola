---
import BrandIcon from "../BrandIcon.astro";

const steps = [
  [0, "idle"],
  [700, "alert"],
  [3000, "press"],
  [3500, "recording"],
];
const tiles = [
  { initials: "M", hue: "#6b8a6b" },
  { initials: "T", hue: "#54739e" },
  { initials: "A", hue: "#a07b5a" },
  { initials: "S", hue: "#7b6f95" },
];
---

<div
  class="meeting"
  data-scene-loop={JSON.stringify(steps)}
  data-duration="8200"
  data-still="alert"
  aria-hidden="true"
>
  <div class="call">
    <div class="strip">
      {tiles.map((tile, i) => (
        <span class:list={["tile", { talking: i === 0 }]} style={`--hue: ${tile.hue}`}>
          <b>{tile.initials}</b>
        </span>
      ))}
    </div>
    <div class="shared">
      <p>Q3 roadmap</p>
      <span class="bars">
        <i style="--h: .4"></i>
        <i style="--h: .65"></i>
        <i style="--h: .5"></i>
        <i style="--h: .85"></i>
      </span>
    </div>
  </div>
  <div class="alert">
    <BrandIcon size={40} class="icon" />
    <p class="title">Zoom is running</p>
    <p class="text">
      Start a system-audio recording? The result lands in your library as a Meeting.
    </p>
    <span class="button primary">Record This Meeting</span>
    <span class="button">Not Now</span>
  </div>
  <div class="dock">
    <span class="app"></span>
    <span class="app"></span>
    <span class="parola">
      <BrandIcon size={34} />
      <b class="badge">0:04</b>
    </span>
    <span class="app"></span>
  </div>
</div>

<style>
  .meeting {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 70% at 90% 0%, rgb(252 242 230 / 0.9), transparent 70%),
      radial-gradient(80% 80% at 0% 100%, #365342, transparent 70%),
      linear-gradient(160deg, #b9cfb5, #6f8f6e 60%, #4a6b51);
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: calc(14 * var(--u));
    display: flex;
    gap: calc(8 * var(--u));
    padding: calc(7 * var(--u));
    border-radius: calc(16 * var(--u));
    background: rgb(255 255 255 / 0.32);
    box-shadow: inset 0 0 0 calc(0.6 * var(--u)) rgb(255 255 255 / 0.5);
    translate: -50% 0;
  }

  .app,
  .parola :global(svg) {
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
  }

  .app {
    border-radius: calc(9 * var(--u));
    background: linear-gradient(160deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.45));
  }

  .parola {
    position: relative;
  }

  .badge {
    position: absolute;
    top: calc(-6 * var(--u));
    right: calc(-10 * var(--u));
    padding: calc(1.5 * var(--u)) calc(5 * var(--u));
    border-radius: 999px;
    background: var(--record);
    color: #fff;
    font-size: calc(9.5 * var(--u));
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .call {
    position: absolute;
    left: calc(34 * var(--u));
    right: calc(34 * var(--u));
    top: calc(46 * var(--u));
    height: calc(290 * var(--u));
    display: grid;
    grid-template-rows: auto 1fr;
    gap: calc(6 * var(--u));
    padding: calc(26 * var(--u)) calc(8 * var(--u)) calc(8 * var(--u));
    border-radius: calc(12 * var(--u));
    background: #1d1f1e;
    box-shadow: 0 calc(14 * var(--u)) calc(30 * var(--u)) rgb(0 0 0 / 0.3);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: calc(5 * var(--u));
  }

  .tile {
    display: grid;
    place-items: center;
    height: calc(52 * var(--u));
    border-radius: calc(7 * var(--u));
    background: radial-gradient(
      90% 90% at 50% 35%,
      color-mix(in srgb, var(--hue) 45%, #2a2d2c),
      #181a19
    );
  }

  .tile.talking {
    box-shadow: inset 0 0 0 calc(2 * var(--u)) var(--sage-soft);
  }

  .tile b {
    display: grid;
    place-items: center;
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
    border-radius: 50%;
    background: var(--hue);
    color: #fff;
    font-size: calc(13 * var(--u));
    font-weight: 600;
  }

  .shared {
    position: relative;
    border-radius: calc(7 * var(--u));
    background: linear-gradient(150deg, #f7f5ef, #e7ece4);
    padding: calc(16 * var(--u)) calc(18 * var(--u));
  }

  .shared p {
    font-family: var(--font-display);
    font-size: calc(17 * var(--u));
    font-weight: 700;
    color: #2c3530;
  }

  .shared .bars {
    position: absolute;
    left: calc(18 * var(--u));
    right: calc(18 * var(--u));
    bottom: calc(14 * var(--u));
    height: calc(110 * var(--u));
    display: flex;
    align-items: flex-end;
    gap: calc(12 * var(--u));
  }

  .shared .bars i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: calc(5 * var(--u)) calc(5 * var(--u)) 0 0;
    background: var(--sage);
    opacity: 0.85;
  }

  .alert {
    position: absolute;
    left: 50%;
    top: calc(96 * var(--u));
    width: calc(236 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(18 * var(--u)) calc(14 * var(--u)) calc(14 * var(--u));
    border-radius: calc(22 * var(--u));
    background: #f4f5f3;
    text-align: center;
    color: #1d201e;
    box-shadow:
      0 0 0 calc(0.6 * var(--u)) rgb(0 0 0 / 0.12),
      0 calc(18 * var(--u)) calc(40 * var(--u)) rgb(0 0 0 / 0.32);
    translate: -50% 0;
    opacity: 0;
    scale: 0.9;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .alert :global(.icon) {
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    margin-bottom: calc(9 * var(--u));
  }

  .title {
    font-size: calc(13 * var(--u));
    font-weight: 700;
  }

  .text {
    margin: calc(5 * var(--u)) 0 calc(11 * var(--u));
    font-size: calc(10.5 * var(--u));
    line-height: 1.35;
  }

  .button {
    width: 100%;
    padding: calc(6 * var(--u)) 0;
    border-radius: calc(11 * var(--u));
    background: rgb(0 0 0 / 0.07);
    font-size: calc(11.5 * var(--u));
    font-weight: 500;
    transition:
      scale 0.15s,
      filter 0.15s;
  }

  .button.primary {
    margin-bottom: calc(6 * var(--u));
    background: #54739e;
    color: #fff;
  }

  [data-state="alert"] .alert,
  [data-state="press"] .alert {
    opacity: 1;
    scale: 1;
  }

  [data-state="press"] .primary {
    scale: 0.96;
    filter: brightness(0.86);
  }

  [data-state="recording"] .badge {
    opacity: 1;
    scale: 1;
  }
</style>
