---
import { hues, type GlyphName, type Hue } from "../../data/icons";
import IconTile from "../IconTile.astro";

const prompts: { name: string; glyph: GlyphName; hue: Hue }[] = [
  { name: "Cleanup", glyph: "broom", hue: "sage" },
  { name: "Action items", glyph: "list-checks", hue: "slate" },
  { name: "Highlight key points", glyph: "highlighter", hue: "clay" },
  { name: "Generate FAQ", glyph: "question", hue: "plum" },
  { name: "Create a mind map", glyph: "tree-structure", hue: "teal" },
  { name: "Translate to Italian", glyph: "translate", hue: "rose" },
];
const steps = prompts.map((_, i) => [i * 1300, `p${i}`]);
---

<div
  class="prompts"
  data-scene-loop={JSON.stringify(steps)}
  data-duration={String(prompts.length * 1300)}
  data-still="p1"
  data-state="p1"
  aria-hidden="true"
>
  <ul>
    {prompts.map((prompt, i) => (
      <li class={`p${i}`} style={`--hue: ${hues[prompt.hue].accent}`}>
        <IconTile glyph={prompt.glyph} hue={prompt.hue} size="calc(28 * var(--u))" />
        {prompt.name}
      </li>
    ))}
  </ul>
</div>

<style>
  .prompts {
    --tint: 11%;
    --tone: 82%;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: calc(28 * var(--u));
  }

  ul {
    display: grid;
    gap: calc(10 * var(--u));
    width: calc(380 * var(--u));
  }

  li {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    padding: calc(13 * var(--u)) calc(18 * var(--u));
    border-radius: calc(16 * var(--u));
    background: color-mix(in srgb, var(--hue) var(--tint), var(--mac-sheet));
    box-shadow: inset 0 0 0 calc(1 * var(--u)) color-mix(in srgb, var(--hue) 22%, transparent);
    color: color-mix(in srgb, var(--hue) var(--tone), var(--mix-ink));
    font-family: var(--font-display);
    font-size: calc(21 * var(--u));
    font-weight: 650;
    letter-spacing: -0.015em;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      scale 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  li :global(.tile) {
    transition: color 0.35s var(--ease-out);
  }

  li :global(.tile)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    background: #fff;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  [data-state="p0"] .p0,
  [data-state="p1"] .p1,
  [data-state="p2"] .p2,
  [data-state="p3"] .p3,
  [data-state="p4"] .p4,
  [data-state="p5"] .p5 {
    background: var(--hue);
    color: #fff;
    scale: 1.03;
    box-shadow: 0 calc(10 * var(--u)) calc(24 * var(--u))
      color-mix(in srgb, var(--hue) 40%, transparent);
  }

  [data-state="p0"] .p0 :global(.tile),
  [data-state="p1"] .p1 :global(.tile),
  [data-state="p2"] .p2 :global(.tile),
  [data-state="p3"] .p3 :global(.tile),
  [data-state="p4"] .p4 :global(.tile),
  [data-state="p5"] .p5 :global(.tile) {
    color: var(--hue);
  }

  [data-state="p0"] .p0 :global(.tile)::after,
  [data-state="p1"] .p1 :global(.tile)::after,
  [data-state="p2"] .p2 :global(.tile)::after,
  [data-state="p3"] .p3 :global(.tile)::after,
  [data-state="p4"] .p4 :global(.tile)::after,
  [data-state="p5"] .p5 :global(.tile)::after {
    opacity: 1;
  }
</style>
