---
import { translator } from "../../i18n";
import Icon from "../Icon.astro";
import IconTile, { type TileArt } from "../IconTile.astro";

const t = translator(Astro.currentLocale);
const here = t({ en: "On this Mac", it: "Su questo Mac" });
const key = t({ en: "Your key", it: "La tua chiave" });
const providers: { name: string; where: string; art: TileArt }[] = [
  { name: "Apple Intelligence", where: here, art: { mark: "intelligence" } },
  { name: "Ollama", where: here, art: { mark: "ollama" } },
  { name: "OpenAI", where: key, art: { mark: "openai" } },
  { name: "Anthropic", where: key, art: { mark: "anthropic" } },
  { name: "Groq", where: key, art: { mark: "groq" } },
  { name: "Cerebras", where: key, art: { mark: "cerebras" } },
  {
    name: t({ en: "Custom endpoint", it: "Endpoint personalizzato" }),
    where: t({ en: "OpenAI-compatible", it: "Compatibile con OpenAI" }),
    art: { glyph: "plugs", hue: "graphite" },
  },
];
const order = [0, 1, 2, 3, 4, 5, 6, 5, 4, 3, 2, 1];
const steps = order.map((index, i) => [i * 1300, `s${index}`]);
---

<div
  class="providers"
  data-scene-loop={JSON.stringify(steps)}
  data-duration={String(order.length * 1300)}
  data-still="s2"
  data-state="s2"
  aria-hidden="true"
>
  <ul>
    {providers.map((provider, i) => (
      <li class={`s${i}`}>
        <IconTile {...provider.art} size="calc(48 * var(--u))" />
        <span class="text">
          <b>{provider.name}</b>
          <small>{provider.where}</small>
        </span>
        <span class="check">
          <Icon name="check" size={16} />
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .providers {
    --at: 2;
    position: absolute;
    inset: 0;
    overflow: hidden;
    mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
  }

  ul {
    display: grid;
    gap: calc(12 * var(--u));
    width: calc(400 * var(--u));
    margin-inline: auto;
    translate: 0 calc(clamp(-176, 180 - var(--at) * 88, 8) * var(--u));
    transition: translate 0.7s var(--ease-in-out);
  }

  li {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    height: calc(76 * var(--u));
    padding-inline: calc(18 * var(--u));
    border-radius: calc(18 * var(--u));
    background: var(--mac-sheet);
    box-shadow:
      0 0 0 calc(1 * var(--u)) rgb(var(--mac-edge) / 0.06),
      0 calc(6 * var(--u)) calc(14 * var(--u)) rgb(15 26 20 / 0.05);
  }

  .text {
    flex: 1;
    display: grid;
  }

  .text b {
    font-family: var(--font-display);
    font-size: calc(19 * var(--u));
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .text small {
    font-size: max(11px, calc(14 * var(--u)));
    font-weight: 500;
    color: var(--muted);
  }

  .check {
    display: grid;
    place-items: center;
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    border-radius: 50%;
    background: var(--accent-fill);
    color: #fff;
    opacity: 0;
    scale: 0.5;
    transition:
      opacity 0.25s var(--ease-out),
      scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .check :global(svg) {
    width: calc(14 * var(--u));
    height: calc(14 * var(--u));
  }

  [data-state="s0"] {
    --at: 0;
  }

  [data-state="s1"] {
    --at: 1;
  }

  [data-state="s3"] {
    --at: 3;
  }

  [data-state="s4"] {
    --at: 4;
  }

  [data-state="s5"] {
    --at: 5;
  }

  [data-state="s6"] {
    --at: 6;
  }

  [data-state="s0"] .s0 .check,
  [data-state="s1"] .s1 .check,
  [data-state="s2"] .s2 .check,
  [data-state="s3"] .s3 .check,
  [data-state="s4"] .s4 .check,
  [data-state="s5"] .s5 .check,
  [data-state="s6"] .s6 .check {
    opacity: 1;
    scale: 1;
  }
</style>
