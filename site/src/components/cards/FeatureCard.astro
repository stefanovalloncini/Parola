---
interface Props {
  title: string;
  text: string;
  note?: string;
  wide?: boolean;
  class?: string;
}

const { title, text, note, wide = false, class: className } = Astro.props;
---

<article class:list={["feature", { wide }, className]}>
  <h3 class="t-card">{title}</h3>
  <p class="t-lead">{text}</p>
  <div class="visual">
    <div class="stage">
      <slot />
    </div>
    {note && <p class="note">{note}</p>}
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  .t-lead {
    margin-top: 14px;
    max-width: 24em;
  }

  .stage {
    --u: calc(100cqw / 500);
    position: relative;
    margin-top: 32px;
    aspect-ratio: 504 / 440;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--mist);
    container-type: inline-size;
    isolation: isolate;
  }

  .stage > :global(*) {
    --u: calc(100cqw / 500);
  }

  @media (min-width: 821px) {
    .wide {
      grid-column: 1 / -1;
    }

    .wide .t-lead {
      max-width: 36em;
    }

    .wide .stage {
      aspect-ratio: 936 / 380;
    }

    .wide .stage > :global(*) {
      --u: calc(100cqw / 936);
    }
  }

  .note {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }
</style>
