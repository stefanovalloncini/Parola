---
import { translator } from "../../i18n";
import IconTile from "../IconTile.astro";

const t = translator(Astro.currentLocale);
const copy = t({
  en: {
    ask: "Transcribe ~/Recordings/standup.m4a as SRT next to the file.",
    running: "running on this Mac",
    done: "done",
    replyBefore: "Done.",
    replyAfter: "is next to the recording.",
  },
  it: {
    ask: "Trascrivi ~/Registrazioni/riunione.m4a in SRT accanto al file.",
    running: "in esecuzione su questo Mac",
    done: "fatto",
    replyBefore: "Fatto.",
    replyAfter: "è accanto alla registrazione.",
  },
});
const ask = copy.ask;
const file = t({ en: "standup.srt", it: "riunione.srt" });
const steps = [
  [0, "asking"],
  [2200, "tool"],
  [4200, "answer"],
  [7000, "rest"],
];
---

<div
  class="mcp"
  data-scene-loop={JSON.stringify(steps)}
  data-duration="8600"
  data-still="answer"
  data-state="answer"
  aria-hidden="true"
>
  <p class="bubble you">
    <span class="sizer">{ask}</span>
    <span data-type="asking" data-text={ask}>
      {ask}
    </span>
  </p>
  <div class="turn">
    <IconTile mark="claude" size="calc(36 * var(--u))" class="avatar" />
    <div class="steps">
      <p class="tool">
        <span class="dot"></span>
        <code>parola_transcribe</code>
        <span class="state">
          <span class="run">{copy.running}</span>
          <span class="ok">{copy.done}</span>
        </span>
      </p>
      <p class="bubble reply">
        {copy.replyBefore} <code>{file}</code> {copy.replyAfter}
      </p>
    </div>
  </div>
</div>

<style>
  .mcp {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--u));
    padding: calc(96 * var(--u)) calc(30 * var(--u)) calc(30 * var(--u));
    font-size: max(11px, calc(20 * var(--u)));
    line-height: 1.4;
  }

  .bubble {
    max-width: 88%;
    padding: calc(15 * var(--u)) calc(20 * var(--u));
    border-radius: calc(22 * var(--u));
  }

  .turn {
    display: flex;
    align-items: flex-start;
    gap: calc(12 * var(--u));
  }

  .steps {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(14 * var(--u));
  }

  .you {
    display: grid;
    align-self: flex-end;
    transition: opacity 0.2s;
    background: var(--ink);
    color: var(--cream);
  }

  .you > span {
    grid-area: 1 / 1;
  }

  .you:has([data-type]:empty) {
    opacity: 0;
  }

  .sizer {
    visibility: hidden;
  }

  .reply {
    background: #fff;
    color: var(--ink-body);
    box-shadow: 0 0 0 calc(1 * var(--u)) rgb(15 26 20 / 0.07);
  }

  code {
    font-family: var(--font-mono);
    font-size: max(11px, 0.9em);
  }

  .tool {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(9 * var(--u));
    max-width: 100%;
    min-height: calc(36 * var(--u));
    padding: calc(7 * var(--u)) calc(12 * var(--u));
    border-radius: calc(18 * var(--u));
    background: var(--sage-tint);
    color: var(--sage-deep);
    font-size: max(11px, calc(16 * var(--u)));
  }

  .tool code {
    white-space: nowrap;
  }

  .dot {
    width: calc(9 * var(--u));
    height: calc(9 * var(--u));
    border-radius: 50%;
    background: var(--sage);
  }

  .state {
    display: grid;
    color: var(--sage-deep);
  }

  .state > span {
    grid-area: 1 / 1;
    transition: opacity 0.12s;
  }

  .ok {
    opacity: 0;
  }

  .tool,
  .reply,
  .turn :global(.avatar) {
    opacity: 0;
    translate: 0 calc(8 * var(--u));
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.4s var(--ease-out);
  }

  :is([data-state="tool"], [data-state="answer"], [data-state="rest"]) .tool,
  :is([data-state="tool"], [data-state="answer"], [data-state="rest"]) :global(.avatar),
  :is([data-state="answer"], [data-state="rest"]) .reply {
    opacity: 1;
    translate: 0 0;
  }

  :is([data-state="answer"], [data-state="rest"]) .run {
    display: none;
  }

  :is([data-state="answer"], [data-state="rest"]) .ok {
    opacity: 1;
    transition: opacity 0.18s 0.12s;
  }
</style>
