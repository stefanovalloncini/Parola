---
import { translator } from "../../i18n";

const t = translator(Astro.currentLocale);
const steps = [
  [0, "idle"],
  [800, "listening"],
  [5000, "transcribing"],
  [5700, "done"],
];
const copy = t({
  en: {
    who: "Maya Chen",
    them: "Can we move the review? Monday is packed.",
    me: "Let me check.",
    said: "Tuesday works better for me. I'll bring the draft.",
    listening: "Listening",
    transcribing: "Transcribing",
  },
  it: {
    who: "Giulia Ferri",
    them: "Possiamo spostare la revisione? Lunedì sono pienissima.",
    me: "Fammi controllare.",
    said: "Per me va meglio martedì. Porto io la bozza.",
    listening: "In ascolto",
    transcribing: "Trascrizione",
  },
});
const said = copy.said;
const levels = [0.4, 0.75, 1, 0.6, 0.85, 0.5, 0.7];
---

<div
  class="dictation"
  data-scene-loop={JSON.stringify(steps)}
  data-duration="8600"
  data-still="listening"
  data-state="listening"
  aria-hidden="true"
>
  <div class="key">
    <span>F5</span>
  </div>
  <div class="thread">
    <p class="who">{copy.who}</p>
    <p class="bubble them">{copy.them}</p>
    <p class="bubble me">{copy.me}</p>
    <div class="pill">
      <span class="row">
        <span class="bars">
          {levels.map((level, i) => (
            <i style={`--l: ${level}; --i: ${i}`} />
          ))}
        </span>
        <span class="label">
          <span class="on">{copy.listening}</span>
          <span class="off">{copy.transcribing}</span>
        </span>
        <span class="stop">
          <i></i>
        </span>
      </span>
    </div>
    <div class="field">
      <span data-type="listening" data-text={said}>
        {said}
      </span>
      <i class="caret"></i>
    </div>
  </div>
</div>

<style>
  .dictation {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #eef2ed, #e3e9e1);
  }

  .thread {
    position: absolute;
    left: calc(40 * var(--u));
    right: calc(40 * var(--u));
    top: calc(44 * var(--u));
    bottom: calc(-10 * var(--u));
    padding: calc(22 * var(--u)) calc(20 * var(--u));
    border-radius: calc(16 * var(--u));
    background: #fff;
    box-shadow:
      0 0 0 calc(0.6 * var(--u)) rgb(15 26 20 / 0.1),
      0 calc(16 * var(--u)) calc(36 * var(--u)) rgb(15 26 20 / 0.16);
    font-size: calc(13.5 * var(--u));
    line-height: 1.35;
  }

  .who {
    margin-bottom: calc(16 * var(--u));
    text-align: center;
    font-size: calc(11.5 * var(--u));
    font-weight: 600;
    color: var(--muted);
  }

  .bubble {
    width: fit-content;
    max-width: 78%;
    margin-bottom: calc(8 * var(--u));
    padding: calc(8 * var(--u)) calc(12 * var(--u));
    border-radius: calc(16 * var(--u));
  }

  .them {
    background: #eceeec;
    color: #1d201e;
  }

  .me {
    margin-left: auto;
    background: var(--sage-deep);
    color: #fff;
  }

  .field {
    position: absolute;
    left: calc(16 * var(--u));
    right: calc(16 * var(--u));
    bottom: calc(26 * var(--u));
    min-height: calc(38 * var(--u));
    padding: calc(9 * var(--u)) calc(14 * var(--u));
    border-radius: calc(19 * var(--u));
    box-shadow: inset 0 0 0 calc(1 * var(--u)) rgb(15 26 20 / 0.16);
    color: #1d201e;
  }

  .caret {
    display: inline-block;
    width: calc(1.5 * var(--u));
    height: 1.1em;
    margin-left: calc(1 * var(--u));
    vertical-align: text-bottom;
    background: var(--sage-deep);
    animation: blink 1.1s steps(1) 12;
  }

  .pill {
    position: absolute;
    left: calc(16 * var(--u));
    bottom: calc(76 * var(--u));
    width: calc(196 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    border-radius: calc(14 * var(--u));
    background: rgb(0 0 0 / 0.88);
    color: rgb(255 255 255 / 0.9);
    font-size: calc(11.5 * var(--u));
    box-shadow: 0 calc(10 * var(--u)) calc(22 * var(--u)) rgb(0 0 0 / 0.25);
    opacity: 0;
    translate: 0 calc(6 * var(--u));
    transition:
      opacity 0.25s var(--ease-out),
      translate 0.35s var(--ease-out);
  }

  .row {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
  }

  .bars {
    display: flex;
    align-items: center;
    gap: calc(1.6 * var(--u));
    width: calc(24 * var(--u));
    height: calc(16 * var(--u));
  }

  .bars i {
    flex: 1;
    height: calc(var(--l) * 100%);
    border-radius: calc(2 * var(--u));
    background: #fff;
  }

  .label {
    flex: 1;
    display: grid;
  }

  .label > span {
    grid-area: 1 / 1;
    transition: opacity 0.2s;
  }

  .off {
    opacity: 0;
  }

  .stop {
    display: grid;
    place-items: center;
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .stop i {
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border-radius: calc(1.5 * var(--u));
    background: #fff;
  }

  .key {
    position: absolute;
    left: calc(14 * var(--u));
    top: calc(14 * var(--u));
    z-index: 2;
    display: grid;
    place-items: center;
    width: calc(58 * var(--u));
    height: calc(54 * var(--u));
    border-radius: calc(10 * var(--u));
    background: linear-gradient(180deg, #fdfdfc, #eceeea);
    box-shadow:
      0 0 0 calc(0.6 * var(--u)) rgb(15 26 20 / 0.16),
      0 calc(4 * var(--u)) 0 #cfd5cd,
      0 calc(10 * var(--u)) calc(18 * var(--u)) rgb(15 26 20 / 0.2);
    color: var(--ink-body);
    font-size: calc(13 * var(--u));
    font-weight: 600;
    transition:
      translate 0.15s,
      box-shadow 0.15s;
  }

  [data-state="listening"] .pill,
  [data-state="transcribing"] .pill {
    opacity: 1;
    translate: 0 0;
  }

  [data-state="listening"] .key {
    translate: 0 calc(3 * var(--u));
    box-shadow:
      0 0 0 calc(0.6 * var(--u)) rgb(15 26 20 / 0.16),
      0 calc(1 * var(--u)) 0 #cfd5cd,
      0 calc(4 * var(--u)) calc(10 * var(--u)) rgb(15 26 20 / 0.2);
  }

  [data-state="transcribing"] .on {
    opacity: 0;
  }

  [data-state="transcribing"] .off {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-state="listening"] .bars i {
      animation: level 0.8s var(--ease-in-out) 24 alternate;
      animation-delay: calc(var(--i) * -0.21s);
    }
  }

  @keyframes level {
    to {
      transform: scaleY(0.35);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
