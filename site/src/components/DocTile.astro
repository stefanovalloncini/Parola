---
import { docTypes, type DocExt } from "../data/icons";
import IconTile from "./IconTile.astro";

interface Props {
  ext: DocExt;
  name?: string;
}

const { ext, name } = Astro.props;
const type = docTypes[ext];
---

<span class="doc" aria-hidden="true">
  <span class="page">
    <span class="sheet">
      <IconTile glyph={type.glyph} hue={type.hue} size="calc(30 * var(--unit))" class="badge" />
      <span class="ext">{ext}</span>
    </span>
  </span>
  {name && <span class="name">{name}</span>}
</span>

<style>
  .doc {
    --unit: var(--doc-unit, 1px);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: var(--doc-width, 84px);
  }

  .page {
    position: relative;
    display: block;
    flex: none;
    width: calc(64 * var(--unit));
    height: calc(80 * var(--unit));
    filter: drop-shadow(0 0 0.5px rgb(15 26 20 / 0.4))
      drop-shadow(0 calc(6 * var(--unit)) calc(8 * var(--unit)) rgb(15 26 20 / 0.16));
  }

  .sheet {
    position: absolute;
    inset: 0;
    border-radius: calc(5 * var(--unit));
    background: linear-gradient(180deg, #ffffff 35%, #eef0ed);
    clip-path: polygon(
      0 0,
      calc(100% - 17 * var(--unit)) 0,
      100% calc(17 * var(--unit)),
      100% 100%,
      0 100%
    );
  }

  .sheet::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: calc(17 * var(--unit));
    height: calc(17 * var(--unit));
    border-bottom-left-radius: calc(3 * var(--unit));
    background: linear-gradient(225deg, transparent 50%, #dde1dc 50%, #f4f5f3);
    filter: drop-shadow(
      calc(-1 * var(--unit)) calc(1.5 * var(--unit)) calc(1.5 * var(--unit)) rgb(15 26 20 / 0.16)
    );
  }

  .sheet :global(.badge) {
    position: absolute;
    left: 50%;
    top: calc(22 * var(--unit));
    translate: -50% 0;
  }

  .ext {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(8 * var(--unit));
    color: #8a918c;
    font-size: calc(9.5 * var(--unit));
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-align: center;
  }

  .name {
    display: -webkit-box;
    max-width: 100%;
    padding: 1px 6px;
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink-body);
    text-align: center;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
