---
import { getImage } from "astro:assets";
import { cropOf, type TabShot } from "../data/crops";
import { tabShotFor } from "../data/shots";
import { localeOf } from "../i18n";

export interface ShotTab {
  id: string;
  label: string;
  shot: TabShot;
  alt: string;
}

interface Props {
  name: string;
  tabs: ShotTab[];
  label: string;
}

const { name, tabs, label } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const phone = "(max-width: 640px)";
const phoneSizes = "calc(100vw - 32px)";
const wideSizes =
  "(max-width: 720px) calc(100vw - 32px), (max-width: 1088px) calc(100vw - 48px), 1040px";

const pictures = await Promise.all(
  tabs.map(async (tab) => {
    const { wide, narrow } = tabShotFor(locale, tab.shot);
    const variants = (image: typeof wide, widths: number[]) =>
      Promise.all(
        (["avif", "webp"] as const).map((format) =>
          getImage({ src: image, format, widths: widths.filter((width) => width <= image.width) }),
        ),
      );
    const [wideSets, narrowSets] = await Promise.all([
      variants(wide, [960, 1440, wide.width]),
      variants(narrow, [400, narrow.width]),
    ]);
    const [, , width, height] = cropOf(tab.shot).wide;
    const [, , narrowWidth, narrowHeight] = cropOf(tab.shot).narrow;
    return {
      wide,
      wideSets,
      narrowSets,
      style: `--w: ${width}; --h: ${height}; --nw: ${narrowWidth}; --nh: ${narrowHeight}`,
    };
  }),
);
---

<div
  class="shot-tabs"
  data-tabs
  style={`--count: ${tabs.length}; --columns: ${tabs.length > 3 ? 2 : tabs.length}`}
>
  <div class="frame">
    {tabs.map((tab, i) => (
      <div
        class="panel"
        id={`${name}-${tab.id}-panel`}
        role="tabpanel"
        tabindex="0"
        aria-labelledby={`${name}-${tab.id}-tab`}
        data-panel
        hidden={i !== 0}
      >
        <div class="crop" style={pictures[i]?.style} data-fade={cropOf(tab.shot).fade}>
          <picture>
            {pictures[i]?.narrowSets.map((set) => (
              <source
                media={phone}
                type={`image/${set.options.format}`}
                srcset={set.srcSet.attribute}
                sizes={phoneSizes}
              />
            ))}
            {pictures[i]?.wideSets.map((set) => (
              <source
                type={`image/${set.options.format}`}
                srcset={set.srcSet.attribute}
                sizes={wideSizes}
              />
            ))}
            <img
              src={pictures[i]?.wideSets[1]?.src}
              width={pictures[i]?.wide.width}
              height={pictures[i]?.wide.height}
              alt={tab.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    ))}
  </div>
  <div class="list" role="tablist" aria-label={label}>
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`${name}-${tab.id}-tab`}
        aria-controls={`${name}-${tab.id}-panel`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-tab
      >
        <span class="track" aria-hidden="true">
          <span class="fill" />
        </span>
        {tab.label}
      </button>
    ))}
  </div>
</div>

<script>
  import { watchTabs } from "../scripts/tabs";
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(watchTabs);
</script>

<style>
  .shot-tabs {
    --dwell: 6s;
  }

  .frame {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
  }

  .crop {
    position: relative;
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    border-radius: 14px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.22),
      0 22px 40px -16px rgb(15 26 20 / 0.32);
  }

  :global([data-theme="dark"]) .crop {
    box-shadow:
      0 0 0 1px rgb(252 242 230 / 0.1),
      0 24px 44px -18px rgb(0 0 0 / 0.6);
  }

  .crop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
    transition:
      visibility 0s 0.6s,
      opacity 0s 0.6s;
  }

  .panel:not([hidden]) {
    z-index: 1;
    animation: shot-in 0.6s var(--ease-out);
  }

  :global(html:not(.js)) .list {
    display: none;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    gap: 10px;
    margin-top: 44px;
  }

  [role="tab"] {
    text-align: left;
    padding-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(17px, 1.2vw + 8px, 24px);
    letter-spacing: -0.018em;
    color: color-mix(in srgb, var(--ink) 66%, transparent);
    transition: color 0.3s var(--ease-out);
  }

  [role="tab"]:hover,
  [role="tab"][aria-selected="true"] {
    color: var(--ink);
  }

  .track {
    display: block;
    height: 3px;
    margin-bottom: 14px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  [aria-selected="true"] .fill {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-playing] [aria-selected="true"] .fill {
      animation: fill var(--dwell) linear both;
    }

    [data-held] [aria-selected="true"] .fill {
      animation-play-state: paused;
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes shot-in {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
  }

  @media (max-width: 640px) {
    .crop {
      aspect-ratio: var(--nw) / var(--nh);
      mask-image: linear-gradient(90deg, #000 78%, transparent);
    }

    .crop[data-fade="both"] {
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    }

    .list {
      grid-template-columns: repeat(var(--columns), 1fr);
      row-gap: 20px;
    }

    [role="tab"] {
      font-size: 16px;
    }
  }
</style>
