---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

export interface ShotTab {
  id: string;
  label: string;
  image: ImageMetadata;
  alt: string;
}

interface Props {
  name: string;
  tabs: ShotTab[];
  label: string;
}

const { name, tabs, label } = Astro.props;
---

<div class="shot-tabs" data-tabs style={`--count: ${tabs.length}`}>
  <div class="frame">
    {tabs.map((tab, i) => (
      <div
        class="panel"
        id={`${name}-${tab.id}-panel`}
        role="tabpanel"
        aria-labelledby={`${name}-${tab.id}-tab`}
        data-panel
        hidden={i !== 0}
      >
        <Picture
          src={tab.image}
          alt={tab.alt}
          formats={["avif", "webp"]}
          widths={[720, 1040, 1560, 2080]}
          sizes="(max-width: 1088px) calc(100vw - 32px), 1040px"
          loading={i === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>
  <div class="list" role="tablist" aria-label={label}>
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`${name}-${tab.id}-tab`}
        aria-controls={`${name}-${tab.id}-panel`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-tab
      >
        <span class="track" aria-hidden="true">
          <span class="fill" />
        </span>
        {tab.label}
      </button>
    ))}
  </div>
</div>

<script>
  import { watchTabs } from "../scripts/tabs";
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(watchTabs);
</script>

<style>
  .shot-tabs {
    --dwell: 6s;
  }

  .frame {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
  }

  .panel :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-window);
    box-shadow: var(--window-shadow);
  }

  .panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
  }

  .panel:not([hidden]) {
    animation: shot-in 0.6s var(--ease-out);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    gap: 10px;
    margin-top: 44px;
  }

  [role="tab"] {
    text-align: left;
    padding-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(17px, 1.2vw + 8px, 24px);
    letter-spacing: -0.018em;
    color: color-mix(in srgb, var(--ink) 66%, transparent);
    transition: color 0.3s var(--ease-out);
  }

  [role="tab"]:hover,
  [role="tab"][aria-selected="true"] {
    color: var(--ink);
  }

  .track {
    display: block;
    height: 3px;
    margin-bottom: 14px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--ink);
  }

  [aria-selected="true"] .fill {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-playing] [aria-selected="true"] .fill {
      animation: fill var(--dwell) linear both;
    }
  }

  @keyframes fill {
    from {
      width: 0;
    }
  }

  @keyframes shot-in {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
  }

  @media (max-width: 640px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 20px;
    }
  }
</style>
