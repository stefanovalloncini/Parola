---
import { Picture } from "astro:assets";
import { crops, shotsFor, type TabShot } from "../data/shots";
import { localeOf } from "../i18n";

export interface ShotTab {
  id: string;
  label: string;
  shot: TabShot;
  alt: string;
}

interface Props {
  name: string;
  tabs: ShotTab[];
  label: string;
}

const { name, tabs, label } = Astro.props;
const shots = shotsFor(localeOf(Astro.currentLocale));
const zoom = (width: number) => (1180 / width).toFixed(3);
const cropStyle = (shot: TabShot) => {
  const { wide, narrow } = crops[shot];
  return [
    `--x: ${wide[0]}; --y: ${wide[1]}; --w: ${wide[2]}; --h: ${wide[3]}`,
    `--nx: ${narrow[0]}; --ny: ${narrow[1]}; --nw: ${narrow[2]}; --nh: ${narrow[3]}`,
  ].join("; ");
};
const sizesFor = (shot: TabShot) => {
  const { wide, narrow } = crops[shot];
  return [
    `(max-width: 640px) calc((100vw - 32px) * ${zoom(narrow[2])})`,
    `(max-width: 1088px) calc((100vw - 32px) * ${zoom(wide[2])})`,
    `${Math.round((1040 * 1180) / wide[2])}px`,
  ].join(", ");
};
---

<div
  class="shot-tabs"
  data-tabs
  style={`--count: ${tabs.length}; --columns: ${tabs.length > 3 ? 2 : tabs.length}`}
>
  <div class="frame">
    {tabs.map((tab, i) => (
      <div
        class="panel"
        id={`${name}-${tab.id}-panel`}
        role="tabpanel"
        tabindex="0"
        aria-labelledby={`${name}-${tab.id}-tab`}
        data-panel
        hidden={i !== 0}
      >
        <div class="crop" style={cropStyle(tab.shot)} data-fade={crops[tab.shot].fade}>
          <Picture
            src={shots[tab.shot]}
            alt={tab.alt}
            formats={["avif", "webp"]}
            widths={[800, 1300, 1800, 2360]}
            sizes={sizesFor(tab.shot)}
            loading="lazy"
          />
        </div>
      </div>
    ))}
  </div>
  <div class="list" role="tablist" aria-label={label}>
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`${name}-${tab.id}-tab`}
        aria-controls={`${name}-${tab.id}-panel`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-tab
      >
        <span class="track" aria-hidden="true">
          <span class="fill" />
        </span>
        {tab.label}
      </button>
    ))}
  </div>
</div>

<script>
  import { watchTabs } from "../scripts/tabs";
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(watchTabs);
</script>

<style>
  .shot-tabs {
    --dwell: 6s;
  }

  .frame {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
  }

  .crop {
    --cx: var(--x);
    --cy: var(--y);
    --cw: var(--w);
    --ch: var(--h);
    position: relative;
    aspect-ratio: var(--cw) / var(--ch);
    overflow: hidden;
    border-radius: 14px;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.22),
      0 22px 40px -16px rgb(15 26 20 / 0.32);
  }

  :global([data-theme="dark"]) .crop {
    box-shadow:
      0 0 0 1px rgb(252 242 230 / 0.1),
      0 24px 44px -18px rgb(0 0 0 / 0.6);
  }

  .crop :global(img) {
    position: absolute;
    left: calc(var(--cx) / var(--cw) * -100%);
    top: calc(var(--cy) / var(--ch) * -100%);
    width: calc(1180 / var(--cw) * 100%);
    max-width: none;
    height: auto;
  }

  .panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
    transition:
      visibility 0s 0.6s,
      opacity 0s 0.6s;
  }

  .panel:not([hidden]) {
    z-index: 1;
    animation: shot-in 0.6s var(--ease-out);
  }

  :global(html:not(.js)) .list {
    display: none;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    gap: 10px;
    margin-top: 44px;
  }

  [role="tab"] {
    text-align: left;
    padding-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(17px, 1.2vw + 8px, 24px);
    letter-spacing: -0.018em;
    color: color-mix(in srgb, var(--ink) 66%, transparent);
    transition: color 0.3s var(--ease-out);
  }

  [role="tab"]:hover,
  [role="tab"][aria-selected="true"] {
    color: var(--ink);
  }

  .track {
    display: block;
    height: 3px;
    margin-bottom: 14px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  [aria-selected="true"] .fill {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-playing] [aria-selected="true"] .fill {
      animation: fill var(--dwell) linear both;
    }

    [data-held] [aria-selected="true"] .fill {
      animation-play-state: paused;
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes shot-in {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
  }

  @media (max-width: 640px) {
    .crop {
      --cx: var(--nx);
      --cy: var(--ny);
      --cw: var(--nw);
      --ch: var(--nh);
      mask-image: linear-gradient(90deg, #000 78%, transparent);
    }

    .crop[data-fade="both"] {
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    }

    .list {
      grid-template-columns: repeat(var(--columns), 1fr);
      row-gap: 20px;
    }

    [role="tab"] {
      font-size: 16px;
    }
  }
</style>
