---
import "../../styles/global.css";
import { Image } from "astro:assets";
import { shotsFor } from "../../data/shots";
import { localeOf, translator } from "../../i18n";
import BrandIcon from "../BrandIcon.astro";

const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const copy = t({
  en: {
    before: "Audio, ",
    mark: "written down",
    sub: ["Speech to text on your Mac.", "Free and open source."],
  },
  it: {
    before: "Audio, ",
    mark: "per iscritto",
    sub: ["Dalla voce al testo, sul tuo Mac.", "Gratis e open source."],
  },
});
const shot = shotsFor(locale)["hero-window"];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Parola social card</title>
  </head>
  <body>
    <div class="card">
      <div class="copy">
        <p class="brand">
          <BrandIcon size={52} /> Parola
        </p>
        <h1>
          {copy.before}
          <span class="keep">
            <span class="mark">{copy.mark}</span>.
          </span>
        </h1>
        <p class="sub">
          {copy.sub[0]}
          <br />
          {copy.sub[1]}
        </p>
      </div>
      <Image class="shot" src={shot} alt="" width={1180} />
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    box-sizing: border-box;
    background:
      radial-gradient(70% 80% at 100% 100%, rgb(107 138 107 / 0.35), transparent 70%),
      linear-gradient(180deg, #fff 30%, #e6eee4);
  }

  .copy {
    position: absolute;
    left: 72px;
    top: 64px;
    width: 560px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h1 {
    margin-top: 110px;
    font-family: var(--font-display);
    font-size: 84px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .keep {
    white-space: nowrap;
  }

  .sub {
    margin-top: 26px;
    font-size: 30px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--muted);
  }

  .shot {
    position: absolute;
    left: 640px;
    top: 96px;
    width: 820px;
    height: auto;
    filter: drop-shadow(0 0 0.5px rgb(0 0 0 / 0.3)) drop-shadow(0 24px 40px rgb(15 26 20 / 0.28));
  }
</style>
