---
import { links } from "../../data/links";
import { translator } from "../../i18n";
import Base from "../../layouts/Base.astro";

const t = translator(Astro.currentLocale);
const copy = t({
  en: {
    title: "Privacy – Parola",
    description: "What Parola and this website do with your data.",
    lead: "Parola is built to keep your recordings and transcripts on your Mac.",
    updated: "Last updated 23 September 2026.",
    app: "The app",
    local:
      "Parola transcribes on your Mac. Your audio is never uploaded. There is no account, and Parola sends no analytics, crash reports or usage data anywhere.",
    online: "Parola connects to the internet only when you ask for something that needs it:",
    reasons: [
      "Downloading a speech model from Hugging Face. After that, transcription works offline.",
      "Fetching the audio behind a link you paste, with yt-dlp. The audio is downloaded to your Mac and transcribed there.",
      "Sending a transcript to an AI service you add yourself, such as OpenAI or Anthropic. Only the text is sent, never the audio, and Parola asks before the first time. If you route dictation cleanup to such a service, the context you allow for it (selected text, the clipboard or text on screen) is sent too. Apple Intelligence and Ollama answer on your Mac.",
    ],
    apple:
      "macOS may download language files for Apple Speech and Apple Translation. That exchange is between your Mac and Apple.",
    log: "Parola keeps a short diagnostics log on your Mac for 7 days, capped at 10 MB. It holds no transcript text, file names or paths, and it never leaves your Mac unless you attach the report to a bug report yourself.",
    site: "This website",
    siteText:
      "This website sets no cookies and loads nothing from other servers. Its fonts and images come from this site too.",
    questions: "Questions",
    write: "Write to",
    subject: "Parola privacy",
  },
  it: {
    title: "Privacy – Parola",
    description: "Cosa fanno Parola e questo sito con i tuoi dati.",
    lead: "Parola nasce per tenere le tue registrazioni e trascrizioni sul tuo Mac.",
    updated: "Ultimo aggiornamento: 23 settembre 2026.",
    app: "L’app",
    local:
      "Parola trascrive sul tuo Mac e il tuo audio non viene mai caricato online. Non serve un account e Parola non invia da nessuna parte statistiche, rapporti sugli arresti anomali o dati d’uso.",
    online: "Parola si collega a internet solo quando fai qualcosa che lo richiede:",
    reasons: [
      "Scaricare un modello vocale da Hugging Face. Da quel momento la trascrizione funziona offline.",
      "Recuperare l’audio di un link che incolli, con yt-dlp. L’audio viene scaricato sul tuo Mac e trascritto lì.",
      "Inviare una trascrizione a un servizio AI che aggiungi tu, come OpenAI o Anthropic. Viene inviato solo il testo, mai l’audio, e Parola chiede conferma la prima volta. Se affidi la pulizia della dettatura a uno di questi servizi, riceve anche il contesto che gli concedi (il testo selezionato, gli appunti o il testo sullo schermo). Apple Intelligence e Ollama rispondono sul tuo Mac.",
    ],
    apple:
      "macOS può scaricare i file delle lingue per Apple Speech e per le traduzioni di Apple. Questo scambio avviene tra il tuo Mac e Apple.",
    log: "Parola tiene sul tuo Mac un breve registro diagnostico per 7 giorni, fino a 10 MB. Non contiene il testo delle trascrizioni, nomi di file o percorsi, ed esce dal tuo Mac solo se sei tu ad allegare il rapporto a una segnalazione.",
    site: "Questo sito",
    siteText:
      "Questo sito non usa cookie e non carica nulla da altri server. Anche i caratteri e le immagini arrivano da qui.",
    questions: "Domande",
    write: "Scrivi a",
    subject: "Privacy di Parola",
  },
});
const mail = `mailto:${links.feedbackEmail}?subject=${encodeURIComponent(copy.subject)}`;
---

<Base title={copy.title} description={copy.description}>
  <article class="narrow legal">
    <h1 class="t-title">Privacy</h1>
    <p class="t-lead">{copy.lead}</p>
    <p class="updated">{copy.updated}</p>

    <h2>{copy.app}</h2>
    <p>{copy.local}</p>
    <p>{copy.online}</p>
    <ul>
      {copy.reasons.map((reason) => (
        <li>{reason}</li>
      ))}
    </ul>
    <p>{copy.apple}</p>
    <p>{copy.log}</p>

    <h2>{copy.site}</h2>
    <p>{copy.siteText}</p>

    <h2>{copy.questions}</h2>
    <p>
      {copy.write} <a href={mail}>{links.feedbackEmail}</a>.
    </p>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(56px, 8vw, 112px);
  }

  .legal .t-lead {
    margin-top: 16px;
  }

  .legal .updated {
    margin-top: 10px;
    margin-bottom: 40px;
    font-size: 14px;
    color: var(--muted);
  }

  h2 {
    margin: 40px 0 12px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  p:not(.t-lead),
  li {
    max-width: 38em;
    color: var(--ink-body);
  }

  p + p {
    margin-top: 14px;
  }

  ul {
    margin: 14px 0;
    display: grid;
    gap: 10px;
    padding-left: 1.2em;
    list-style: disc;
  }

  a {
    color: var(--sage-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
