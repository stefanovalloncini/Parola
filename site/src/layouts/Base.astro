---
import "@fontsource-variable/inter/opsz.css";
import "@fontsource/newsreader/400.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { locales, localeOf, pathFor, translator } from "../i18n";

interface Props {
  title: string;
  description: string;
  indexed?: boolean;
}

const { title, description, indexed = true } = Astro.props;
const hidden = !indexed || process.env.NOINDEX === "1";
const locale = localeOf(Astro.currentLocale);
const t = translator(locale);
const path = Astro.url.pathname;
const absolute = (href: string) => (Astro.site ? new URL(href, Astro.site).href : undefined);
const canonical = indexed ? absolute(path) : undefined;
const ogImage = absolute(locale === "it" ? "/og-it.png" : "/og.png");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a110d" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {hidden && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical &&
      locales.map((other) => (
        <link rel="alternate" hreflang={other} href={absolute(pathFor(other, path))} />
      ))}
    {canonical && (
      <link rel="alternate" hreflang="x-default" href={absolute(pathFor("en", path))} />
    )}
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parola" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t({ en: "Skip to content", it: "Vai al contenuto" })}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { playWhenVisible, revealWords } from "../scripts/reveal";
  import { runSceneLoops } from "../scripts/scene-loop";
  revealWords();
  playWhenVisible();
  runSceneLoops();
</script>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  main {
    flex: 1;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
  }

  .skip:focus-visible {
    top: 12px;
  }
</style>
