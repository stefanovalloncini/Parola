---
import "../styles/global.css";
import { Image } from "astro:assets";
import shot from "../assets/shots/hero-window.png";
import BrandIcon from "../components/BrandIcon.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Parola social card</title>
  </head>
  <body>
    <div class="card">
      <div class="copy">
        <p class="brand">
          <BrandIcon size={52} /> Parola
        </p>
        <h1>
          Audio, <span class="mark">written down</span>.
        </h1>
        <p class="sub">
          Speech to text on your Mac.
          <br />
          Free and open source.
        </p>
      </div>
      <Image class="shot" src={shot} alt="" width={1180} />
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    box-sizing: border-box;
    background:
      radial-gradient(70% 80% at 100% 100%, rgb(107 138 107 / 0.35), transparent 70%),
      linear-gradient(180deg, #fff 30%, #e6eee4);
  }

  .copy {
    position: absolute;
    left: 72px;
    top: 64px;
    width: 560px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h1 {
    margin-top: 110px;
    font-family: var(--font-display);
    font-size: 84px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .sub {
    margin-top: 26px;
    font-size: 30px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--muted);
  }

  .shot {
    position: absolute;
    left: 640px;
    top: 96px;
    width: 820px;
    height: auto;
    filter: drop-shadow(0 0 0.5px rgb(0 0 0 / 0.3)) drop-shadow(0 24px 40px rgb(15 26 20 / 0.28));
  }
</style>
