---
import Story from "../components/hero/Story.astro";
import AISection from "../components/sections/AISection.astro";
import AutomationSection from "../components/sections/AutomationSection.astro";
import DropSection from "../components/sections/DropSection.astro";
import EnginesSection from "../components/sections/EnginesSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import FeaturesSection from "../components/sections/FeaturesSection.astro";
import FreeSection from "../components/sections/FreeSection.astro";
import OpenWorkSection from "../components/sections/OpenWorkSection.astro";
import PrivacySection from "../components/sections/PrivacySection.astro";
import { links } from "../data/links";
import Base from "../layouts/Base.astro";

const description =
  "Parola transcribes recordings, meetings and dictation on your Mac. Free and open source.";
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Parola",
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 26 or later, Apple Silicon",
  downloadUrl: links.download,
  license: "https://opensource.org/licenses/MIT",
  author: { "@type": "Person", name: "Stefano Valloncini" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---

<Base title="Parola – speech to text on your Mac" description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(app)}></script>
  <Story />
  <DropSection />
  <FeaturesSection />
  <PrivacySection />
  <EnginesSection />
  <AISection />
  <AutomationSection />
  <OpenWorkSection />
  <FreeSection />
  <FaqSection />
</Base>
