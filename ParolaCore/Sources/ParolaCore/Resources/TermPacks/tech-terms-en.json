{
  "name": "Tech Terms (English)",
  "locale": "en",
  "version": 2,
  "rules": [
    { "find": "\\bk 8 s\\b",      "replace": "Kubernetes", "caseSensitive": false, "regex": true },
    { "find": "\\bkubernetes\\b", "replace": "Kubernetes", "caseSensitive": false, "regex": true },
    { "find": "\\bgrpc\\b",       "replace": "gRPC",       "caseSensitive": false, "regex": true },
    { "find": "\\bg r p c\\b",    "replace": "gRPC",       "caseSensitive": false, "regex": true },
    { "find": "\\bpostgres\\b",   "replace": "Postgres",   "caseSensitive": false, "regex": true },
    { "find": "\\bpostgresql\\b", "replace": "PostgreSQL", "caseSensitive": false, "regex": true },
    { "find": "\\bgraphql\\b",    "replace": "GraphQL",    "caseSensitive": false, "regex": true },
    { "find": "\\bgithub\\b",     "replace": "GitHub",     "caseSensitive": false, "regex": true },
    { "find": "\\bopenai\\b",     "replace": "OpenAI",     "caseSensitive": false, "regex": true },
    { "find": "\\bjavascript\\b", "replace": "JavaScript", "caseSensitive": false, "regex": true },
    { "find": "\\btypescript\\b", "replace": "TypeScript", "caseSensitive": false, "regex": true },
    { "find": "\\bswiftui\\b",    "replace": "SwiftUI",    "caseSensitive": false, "regex": true },
    { "find": "\\bmacos\\b",      "replace": "macOS",      "caseSensitive": false, "regex": true },
    { "find": "\\bios\\b",        "replace": "iOS",        "caseSensitive": false, "regex": true },
    { "find": "\\bi pad os\\b",   "replace": "iPadOS",     "caseSensitive": false, "regex": true },
    { "find": "\\btv os\\b",      "replace": "tvOS",       "caseSensitive": false, "regex": true },
    { "find": "\\bwatch os\\b",   "replace": "watchOS",    "caseSensitive": false, "regex": true },
    { "find": "\\bssh\\b",        "replace": "SSH",        "caseSensitive": false, "regex": true },
    { "find": "\\btls\\b",        "replace": "TLS",        "caseSensitive": false, "regex": true },
    { "find": "\\bjson\\b",       "replace": "JSON",       "caseSensitive": false, "regex": true },
    { "find": "\\byaml\\b",       "replace": "YAML",       "caseSensitive": false, "regex": true },
    { "find": "\\burl\\b",        "replace": "URL",        "caseSensitive": false, "regex": true },
    { "find": "\\buuid\\b",       "replace": "UUID",       "caseSensitive": false, "regex": true },
    { "find": "\\bapi\\b",        "replace": "API",        "caseSensitive": false, "regex": true },
    { "find": "\\bsdk\\b",        "replace": "SDK",        "caseSensitive": false, "regex": true }
  ]
}
